"""
Eval cases for the natural-language layer.

Following the agentic-engineering skill's eval-first loop:
  - Capability evals: does NL input X produce plan Y?
  - Regression evals: bugs we've already fixed must not come back

Each case pairs a user utterance with an expected outcome. Cases are grouped
by subsystem (planner, dispatcher) so regressions are attributable.

The harness (run.py) executes each case with a seeded MockLLM and reports
pass/fail with a diff on failure. Designed to run in CI or on demand.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any


@dataclass
class PlannerCase:
    """A single planner eval case.

    id:            stable identifier so reports can track the same case over time
    input:         natural language from the user
    llm_response:  what the mocked LLM returns (JSON array as string)
    expected:      the plan we expect the planner to produce
    notes:         why this case matters (regression link, edge case, etc.)
    """

    id: str
    input: str
    llm_response: str
    expected: list[dict[str, Any]]
    notes: str = ""


@dataclass
class DispatcherCase:
    """A single dispatcher eval case."""

    id: str
    input: str
    llm_response: str
    expected_mode: str  # chat | tools | mixed
    history: list[dict[str, str]] = field(default_factory=list)
    notes: str = ""


# ---------------------------------------------------------------------
# Planner cases
# ---------------------------------------------------------------------

PLANNER_CASES: list[PlannerCase] = [
    # --- Capability: basic single-tool plans ---
    PlannerCase(
        id="plan.list_simple",
        input="list my downloads",
        llm_response='[{"tool":"list_dir","args":{"path":"~/Downloads"}}]',
        expected=[{"tool": "list_dir", "args": {"path": "~/Downloads"}}],
        notes="Baseline: single tool call from clear NL.",
    ),
    PlannerCase(
        id="plan.create_file_with_name",
        input="make me a note called ideas.txt",
        llm_response='[{"tool":"create_file","args":{"path":"ideas.txt"}}]',
        expected=[{"tool": "create_file", "args": {"path": "ideas.txt"}}],
    ),
    PlannerCase(
        id="plan.scan_with_mode",
        input="do a deep scan of this folder",
        llm_response='[{"tool":"scan","args":{"path":".","mode":"HIGH"}}]',
        expected=[{"tool": "scan", "args": {"path": ".", "mode": "HIGH"}}],
    ),
    PlannerCase(
        id="plan.web_search_phrasal",
        input="what does python's asyncio module do",
        llm_response='[{"tool":"web_search","args":{"query":"python asyncio module"}}]',
        expected=[{"tool": "web_search", "args": {"query": "python asyncio module"}}],
    ),
    PlannerCase(
        id="plan.multi_step",
        input="create a todo file and then list this directory",
        llm_response=(
            '[{"tool":"create_file","args":{"path":"todo.txt"}},'
            '{"tool":"list_dir","args":{"path":"."}}]'
        ),
        expected=[
            {"tool": "create_file", "args": {"path": "todo.txt"}},
            {"tool": "list_dir", "args": {"path": "."}},
        ],
        notes="Multi-step plan preserves order.",
    ),
    # --- Capability: robustness of output parsing ---
    PlannerCase(
        id="plan.fenced_output",
        input="list here",
        llm_response='```json\n[{"tool":"list_dir","args":{"path":"."}}]\n```',
        expected=[{"tool": "list_dir", "args": {"path": "."}}],
        notes="Model wraps output in markdown fences - still parses.",
    ),
    PlannerCase(
        id="plan.chatty_preamble",
        input="list this folder",
        llm_response='Sure! Here you go: [{"tool":"list_dir","args":{"path":"."}}]',
        expected=[{"tool": "list_dir", "args": {"path": "."}}],
        notes="Regex extracts first [...] from chatty model response.",
    ),
    PlannerCase(
        id="plan.malformed_step_skipped",
        input="mixed bag",
        llm_response=(
            '[{"tool":"list_dir","args":{}},'
            '"garbage",'
            '{"no_tool":"x"},'
            '{"tool":"sysinfo","args":{}}]'
        ),
        expected=[
            {"tool": "list_dir", "args": {}},
            {"tool": "sysinfo", "args": {}},
        ],
        notes="Malformed list items are skipped, valid ones retained.",
    ),
    # --- Regression guards ---
    PlannerCase(
        id="regress.empty_array_returns_none",
        input="make me a sandwich",
        llm_response="[]",
        expected=[],
        notes="Regression: empty array means 'can't do this', NOT trigger regex fallback in tests.",
    ),
    PlannerCase(
        id="regress.preserve_path_case",
        input="list ~/Documents/MyProject",
        llm_response='[{"tool":"list_dir","args":{"path":"~/Documents/MyProject"}}]',
        expected=[{"tool": "list_dir", "args": {"path": "~/Documents/MyProject"}}],
        notes="Regression: paths must preserve exact case, not lowercased.",
    ),
    PlannerCase(
        id="regress.plan_is_list_not_object",
        input="list here",
        llm_response='{"tool":"list_dir","args":{}}',  # object not array - should reject
        expected=None,  # special: None means planner returns None (invalid LLM output)
        notes="Regression: planner must reject bare objects, require arrays.",
    ),
]


# ---------------------------------------------------------------------
# Dispatcher cases
# ---------------------------------------------------------------------

DISPATCHER_CASES: list[DispatcherCase] = [
    DispatcherCase(
        id="disp.greeting_is_chat",
        input="hey what's up",
        llm_response='{"mode":"chat","reasoning":"greeting"}',
        expected_mode="chat",
    ),
    DispatcherCase(
        id="disp.action_is_tools",
        input="show me what's in my downloads folder",
        llm_response='{"mode":"tools","reasoning":"directory listing"}',
        expected_mode="tools",
    ),
    DispatcherCase(
        id="disp.combined_is_mixed",
        input="scan my desktop and tell me what looks old",
        llm_response='{"mode":"mixed","reasoning":"scan plus narration"}',
        expected_mode="mixed",
    ),
    DispatcherCase(
        id="disp.explain_is_chat",
        input="explain how recursion works",
        llm_response='{"mode":"chat","reasoning":"concept explanation"}',
        expected_mode="chat",
    ),
    DispatcherCase(
        id="disp.fenced_output",
        input="list",
        llm_response='```json\n{"mode":"tools","reasoning":"list command"}\n```',
        expected_mode="tools",
        notes="Dispatcher tolerates fenced JSON.",
    ),
    DispatcherCase(
        id="disp.garbage_falls_back_to_heuristic",
        input="list my files please",
        llm_response="I dunno maybe tools?",
        expected_mode="tools",
        notes="Non-JSON -> heuristic picks 'tools' because 'list' is action verb.",
    ),
    DispatcherCase(
        id="disp.garbage_no_action_verb",
        input="how are you today friend",
        llm_response="hmm",
        expected_mode="chat",
        notes="Non-JSON, no action verb -> heuristic picks 'chat'.",
    ),
    DispatcherCase(
        id="disp.invalid_mode_defaults_chat",
        input="anything",
        llm_response='{"mode":"dance_mode","reasoning":"?"}',
        expected_mode="chat",
        notes="Unknown mode defaults to chat (fail-closed toward safety).",
    ),
    DispatcherCase(
        id="disp.followup_uses_history",
        input="yes do it",
        llm_response='{"mode":"tools","reasoning":"user confirming previous offer"}',
        expected_mode="tools",
        history=[
            {"role": "user", "content": "should I clean up tmp?"},
            {"role": "assistant", "content": "Want me to delete old files in /tmp?"},
        ],
        notes="Regression: short history window must be passed to LLM for followups.",
    ),
]
