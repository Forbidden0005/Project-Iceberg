<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Iceberg</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --bg:#070c1a;
  --surf:#0b1124;
  --card:#0f1830;
  --card2:#131e3a;
  --bdr:rgba(48,80,148,0.3);
  --bdr2:rgba(60,100,180,0.5);
  --bdr3:rgba(61,143,255,0.6);
  --accent:#3d8fff;
  --accent2:#6ab0ff;
  --cyan:#00c8f0;
  --green:#00e09a;
  --red:#ff4455;
  --amber:#ffaa00;
  --t1:#d4e5ff;
  --t2:#5f7dac;
  --t3:#28385a;
  --fd:'Chakra Petch',sans-serif;
  --fm:'JetBrains Mono',monospace;
}

html,body{height:100%;background:var(--bg);color:var(--t1);font-family:var(--fm);font-size:13px;line-height:1.5;overflow:hidden}

.shell{
  display:grid;
  grid-template-rows:48px 1fr auto;
  grid-template-columns:268px 1fr 244px;
  height:100vh;
}

/* ── SCANLINES ──────────────────────────────────────────── */
.scanlines{
  position:fixed;inset:0;pointer-events:none;z-index:9999;
  background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.025) 2px,rgba(0,0,0,0.025) 4px);
}

/* ── TOPBAR ─────────────────────────────────────────────── */
.topbar{
  grid-column:1/-1;grid-row:1;
  display:flex;align-items:center;gap:14px;
  padding:0 20px;
  background:var(--surf);
  border-bottom:1px solid var(--bdr);
}

.logo{
  display:flex;align-items:center;gap:10px;
  font-family:var(--fd);font-size:15px;font-weight:700;
  letter-spacing:0.14em;color:var(--t1);text-transform:uppercase;
  margin-right:6px;
}

.logo svg{flex-shrink:0}

.pill{
  display:flex;align-items:center;gap:6px;
  padding:4px 11px;
  background:var(--card);border:1px solid var(--bdr);border-radius:4px;
  font-family:var(--fm);font-size:11px;color:var(--t2);
  white-space:nowrap;
}
.pill .pval{color:var(--t1);font-weight:500}

.pdot{
  width:6px;height:6px;border-radius:50%;flex-shrink:0;
}
.pdot.g{background:var(--green);box-shadow:0 0 7px var(--green);animation:glow 2.4s ease-in-out infinite}
.pdot.b{background:var(--accent);box-shadow:0 0 7px var(--accent)}
.pdot.off{background:var(--t3)}

@keyframes glow{0%,100%{opacity:1}50%{opacity:.35}}

.spacer{flex:1}

.tbtn{
  padding:5px 13px;background:transparent;
  border:1px solid var(--bdr2);border-radius:4px;
  color:var(--t2);font-family:var(--fd);font-size:10px;font-weight:600;
  letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;
  transition:all .15s;
}
.tbtn:hover{border-color:var(--accent);color:var(--accent2)}
.tbtn.active{border-color:var(--green);color:var(--green)}
.tbtn.danger{border-color:rgba(255,68,85,0.4);color:rgba(255,68,85,0.6)}
.tbtn.danger:hover{border-color:var(--red);color:var(--red)}

/* ── LEFT PANEL ─────────────────────────────────────────── */
.lp{
  grid-column:1;grid-row:2;
  background:var(--surf);border-right:1px solid var(--bdr);
  overflow:hidden;padding:10px;
  display:flex;flex-direction:column;gap:6px;
}

.plabel{
  font-family:var(--fd);font-size:9px;font-weight:700;
  letter-spacing:0.2em;text-transform:uppercase;color:var(--t3);
  padding:2px 4px;margin-bottom:2px;
}

/* server cards */
.sc{
  background:var(--card);border:1px solid var(--bdr);border-radius:6px;
  padding:12px 11px;cursor:pointer;transition:all .15s;
  position:relative;overflow:hidden;
}
.sc::before{
  content:'';position:absolute;left:0;top:0;bottom:0;width:2px;
  background:transparent;transition:background .2s;
}
.sc:hover{background:var(--card2);border-color:var(--bdr2)}
.sc:hover::before{background:var(--accent)}
.sc.expanded{border-color:var(--bdr3)}
.sc.expanded::before{background:var(--accent)}

.sc-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:5px}

.sc-name{
  font-family:var(--fd);font-size:11px;font-weight:700;
  letter-spacing:0.06em;text-transform:uppercase;color:var(--t1);
}

.sc-status{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--t2)}

.sdot{
  width:7px;height:7px;border-radius:50%;flex-shrink:0;
}
.sdot.on{background:var(--green);box-shadow:0 0 8px var(--green);animation:glow 2.4s ease-in-out infinite}
.sdot.off{background:var(--t3)}

.sc-desc{font-size:11px;color:var(--t2);margin-bottom:7px;line-height:1.4}

.sc-count{
  font-family:var(--fd);font-size:11px;letter-spacing:0.08em;
  text-transform:uppercase;color:var(--t2);
}
.sc-count span{color:var(--accent2)}

.sc-tools{
  margin-top:9px;padding-top:9px;border-top:1px solid var(--bdr);
  display:none;flex-direction:column;gap:2px;
}
.sc.expanded .sc-tools{display:flex}

.sc-tool{font-size:11px;color:var(--t2);padding:1px 0}
.sc-tool::before{content:'→ ';color:var(--t3)}
.sc-more{font-size:10px;color:var(--t3);font-style:italic;padding-left:14px;margin-top:2px}

.divider{height:1px;background:var(--bdr);margin:2px 0}

.add-btn{
  width:100%;padding:8px;background:transparent;
  border:1px dashed var(--bdr2);border-radius:5px;
  color:var(--t3);font-family:var(--fd);font-size:10px;font-weight:600;
  letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;
  transition:all .15s;text-align:center;
}
.add-btn:hover{border-color:var(--accent);color:var(--accent2)}

/* ── CHAT ───────────────────────────────────────────────── */
.cc{
  grid-column:2;grid-row:2;
  display:flex;flex-direction:column;overflow:hidden;
  border-right:1px solid var(--bdr);
}

.msgs{
  flex:1;overflow-y:auto;
  padding:22px 22px 10px;
  display:flex;flex-direction:column;gap:18px;
}
.msgs::-webkit-scrollbar{width:4px}
.msgs::-webkit-scrollbar-track{background:transparent}
.msgs::-webkit-scrollbar-thumb{background:var(--bdr2);border-radius:2px}

.msg{display:flex;flex-direction:column;max-width:82%;animation:msgIn .22s ease-out}
@keyframes msgIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

.msg.u{align-self:flex-end;align-items:flex-end}
.msg.a{align-self:flex-start;align-items:flex-start}

.mmeta{
  font-size:9px;color:var(--t3);margin-bottom:4px;
  letter-spacing:0.08em;text-transform:uppercase;font-family:var(--fd);
}

.mbubble{
  padding:10px 14px;border-radius:8px;
  font-size:13px;line-height:1.65;
}
.msg.u .mbubble{
  background:rgba(61,143,255,0.14);
  border:1px solid rgba(61,143,255,0.3);
  color:var(--t1);
}
.msg.a .mbubble{
  background:var(--card);border:1px solid var(--bdr);color:var(--t1);
}

/* tool execution block */
.toolex{
  margin-top:8px;
  background:rgba(5,8,20,0.8);
  border:1px solid var(--bdr);border-left:2px solid var(--accent);
  border-radius:6px;padding:8px 12px;
  font-size:11px;
}
.toolex-head{
  display:flex;align-items:center;gap:6px;
  font-family:var(--fd);font-size:9px;font-weight:700;
  letter-spacing:0.12em;text-transform:uppercase;color:var(--accent2);
  margin-bottom:5px;
}
.toolex-name{color:var(--t2);font-family:var(--fm);margin-bottom:4px}
.toolex-result{
  color:var(--t2);font-size:11px;
  white-space:pre-wrap;max-height:72px;overflow-y:auto;
  border-top:1px solid var(--bdr);padding-top:4px;margin-top:4px;
}
.toolex-result::-webkit-scrollbar{width:2px}
.toolex-result::-webkit-scrollbar-thumb{background:var(--bdr2)}

/* typing indicator */
.typing-wrap{
  background:var(--card);border:1px solid var(--bdr);border-radius:8px;
  padding:11px 16px;
  display:flex;align-items:center;gap:5px;
}
.tdot{
  width:5px;height:5px;border-radius:50%;background:var(--t2);
  animation:bounce 1.2s ease-in-out infinite;
}
.tdot:nth-child(2){animation-delay:.2s}
.tdot:nth-child(3){animation-delay:.4s}
@keyframes bounce{0%,100%{transform:translateY(0);opacity:.35}50%{transform:translateY(-5px);opacity:1}}

/* ── INPUT BAR ──────────────────────────────────────────── */
.ib{
  grid-column:2;grid-row:3;
  display:flex;align-items:center;gap:8px;
  padding:10px 16px;min-height:58px;
  background:var(--surf);border-top:1px solid var(--bdr);
  border-right:1px solid var(--bdr);
  flex-wrap:wrap;
}

.cinput{
  flex:1;background:var(--card);border:1px solid var(--bdr);border-radius:6px;
  padding:9px 14px;color:var(--t1);font-family:var(--fm);font-size:13px;
  outline:none;resize:none;height:38px;transition:border-color .15s;
}
.cinput:focus{border-color:var(--bdr3)}
.cinput::placeholder{color:var(--t3)}

.ibtn{
  width:36px;height:36px;border-radius:6px;
  background:var(--card);border:1px solid var(--bdr);
  color:var(--t2);display:flex;align-items:center;justify-content:center;
  cursor:pointer;transition:all .15s;flex-shrink:0;
}
.ibtn:hover{border-color:var(--accent);color:var(--accent2)}
.ibtn.send{background:var(--accent);border-color:var(--accent);color:#fff}
.ibtn.send:hover{background:var(--accent2);border-color:var(--accent2)}
.ibtn:disabled{opacity:.4;cursor:not-allowed}

/* ── RIGHT PANEL ────────────────────────────────────────── */
.rp{
  grid-column:3;grid-row:2;
  background:var(--surf);overflow-y:auto;
  padding:14px 10px;display:flex;flex-direction:column;gap:3px;
}
.rp::-webkit-scrollbar{width:3px}
.rp::-webkit-scrollbar-thumb{background:var(--bdr2);border-radius:2px}

.sinput{
  width:100%;background:var(--card);border:1px solid var(--bdr);
  border-radius:4px;padding:6px 10px;color:var(--t1);
  font-family:var(--fm);font-size:11px;outline:none;
  transition:border-color .15s;margin-bottom:10px;
}
.sinput:focus{border-color:var(--bdr3)}
.sinput::placeholder{color:var(--t3)}

/* ── TOOL TREE ──────────────────────────────────────────────── */
.tc-group{margin-bottom:1px}

.tc-header{
  display:flex;align-items:center;gap:6px;
  padding:5px 6px;border-radius:4px;cursor:pointer;
  user-select:none;transition:background .12s;
}
.tc-header:hover{background:var(--card)}

.tc-arrow{
  width:10px;flex-shrink:0;font-size:9px;color:var(--t3);
  transition:transform .16s ease;display:inline-block;line-height:1;
}
.tc-group.open>.tc-header .tc-arrow{transform:rotate(90deg)}

.tc-icon{font-size:13px;flex-shrink:0;line-height:1}

.tc-label{
  font-family:var(--fd);font-size:9px;font-weight:700;
  letter-spacing:0.18em;text-transform:uppercase;color:var(--t2);flex:1;
  transition:color .12s;
}
.tc-group.open>.tc-header .tc-label{color:var(--t1)}

.tc-count{
  font-family:var(--fd);font-size:9px;color:var(--t3);
  background:rgba(48,80,148,0.22);padding:1px 6px;border-radius:8px;
  min-width:18px;text-align:center;
}

.tc-body{
  overflow:hidden;
  max-height:0;
  transition:max-height .2s ease-out;
}
.tc-group.open>.tc-body{max-height:800px}

.tc-tool{
  display:flex;align-items:center;gap:7px;
  padding:3px 6px 3px 20px;border-radius:3px;
  cursor:default;transition:background .1s;
}
.tc-tool:hover{background:var(--card)}
.tc-tool.tc-hidden{display:none}
.tc-group.tc-hidden{display:none}

.tc-dot{width:5px;height:5px;border-radius:50%;flex-shrink:0;opacity:.8}

.tc-tname{
  font-family:var(--fm);font-size:11px;color:var(--accent2);
  flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}

/* ── LEFT PANEL TABS ────────────────────────────────────────── */
.lp-tabs{
  display:flex;gap:2px;padding:3px;
  background:var(--bg);border-radius:5px;
  flex-shrink:0;
}
.lp-tab{
  flex:1;padding:6px 4px;background:transparent;border:none;
  border-radius:3px;color:var(--t3);font-family:var(--fd);font-size:9px;
  font-weight:700;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;
  transition:all .15s;display:flex;align-items:center;justify-content:center;gap:4px;
}
.lp-tab:hover{color:var(--t2);background:var(--card)}
.lp-tab.active{background:var(--card2);color:var(--t1);box-shadow:inset 0 -2px 0 var(--accent)}

.lp-pane{
  display:flex;flex-direction:column;gap:6px;
  flex:1;overflow-y:auto;min-height:0;
}
.lp-pane.hidden{display:none!important}
.lp-pane::-webkit-scrollbar{width:3px}
.lp-pane::-webkit-scrollbar-thumb{background:var(--bdr2);border-radius:2px}

/* ── SKILLS PANEL ───────────────────────────────────────────── */
.sk-item{
  display:flex;align-items:flex-start;gap:7px;
  padding:7px 8px;border-radius:5px;
  border:1px solid transparent;transition:all .12s;
}
.sk-item:hover{background:var(--card);border-color:var(--bdr)}
.sk-item.active{background:rgba(61,143,255,0.07);border-color:rgba(61,143,255,0.2)}

.sk-info{flex:1;min-width:0}
.sk-name{
  font-family:var(--fm);font-size:11px;color:var(--accent2);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  display:flex;align-items:center;gap:4px;flex-wrap:wrap;
}
.sk-item.active .sk-name{color:var(--t1)}
.sk-desc{font-size:9px;color:var(--t3);margin-top:2px;line-height:1.4}

.sk-add{
  width:22px;height:22px;border-radius:4px;flex-shrink:0;margin-top:1px;
  background:transparent;border:1px solid var(--bdr2);color:var(--t2);
  font-size:14px;line-height:1;cursor:pointer;
  display:flex;align-items:center;justify-content:center;transition:all .12s;
}
.sk-add:hover{background:var(--accent);border-color:var(--accent);color:#fff}
.sk-add.added{background:rgba(0,224,154,0.1);border-color:var(--green);color:var(--green)}

.sk-active-hdr{
  font-family:var(--fd);font-size:9px;font-weight:700;
  letter-spacing:0.16em;text-transform:uppercase;
  color:var(--green);padding:2px 4px;
  display:flex;align-items:center;gap:5px;
}
.sk-active-dot{width:5px;height:5px;border-radius:50%;background:var(--green);box-shadow:0 0 5px var(--green);animation:glow 2.4s ease-in-out infinite}
.sk-install-btn{
  width:22px;height:22px;border-radius:50%;border:1.5px solid var(--accent);
  background:transparent;color:var(--accent);font-size:16px;line-height:1;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  transition:background .15s,color .15s;flex-shrink:0;padding:0;
}
.sk-install-btn:hover{background:var(--accent);color:#fff}

/* ── ACTIVE SKILL STRIP (above textarea) ────────────────────── */
.sk-strip-bar{
  width:100%;display:flex;align-items:center;gap:6px;
  padding-bottom:8px;flex-wrap:wrap;order:-1;
  border-bottom:1px solid var(--bdr);margin-bottom:2px;
}
.sk-strip-label{
  font-family:var(--fd);font-size:9px;color:var(--t3);
  letter-spacing:0.1em;text-transform:uppercase;flex-shrink:0;
}
#sk-strip-pills{display:flex;gap:5px;flex-wrap:wrap;flex:1}
.sk-pill{
  display:flex;align-items:center;gap:4px;
  padding:2px 8px;border-radius:10px;
  background:rgba(61,143,255,0.1);border:1px solid rgba(61,143,255,0.25);
  font-family:var(--fm);font-size:10px;color:var(--accent2);
}
.sk-pill-x{
  background:none;border:none;color:var(--t3);cursor:pointer;
  font-size:12px;padding:0;line-height:1;margin-left:2px;
  transition:color .1s;
}
.sk-pill-x:hover{color:var(--red)}

/* ── SLASH POPUP ────────────────────────────────────────────── */
.slash-popup{
  position:fixed;
  background:var(--surf);border:1px solid var(--bdr2);
  border-bottom:none;border-radius:6px 6px 0 0;
  overflow:hidden;z-index:60;
  box-shadow:0 -8px 28px rgba(0,0,0,0.55);
}
.slash-hdr{
  padding:5px 12px;background:var(--bg);
  border-bottom:1px solid var(--bdr);
  display:flex;align-items:center;justify-content:space-between;
}
.slash-hdr-title{
  font-family:var(--fd);font-size:9px;font-weight:700;
  letter-spacing:0.16em;text-transform:uppercase;color:var(--accent2);
}
.slash-hdr-hint{
  font-family:var(--fm);font-size:9px;color:var(--t3);
}
.slash-item{
  display:flex;align-items:center;gap:10px;
  padding:8px 12px;cursor:pointer;
  border-bottom:1px solid var(--bdr);transition:background .08s;
}
.slash-item:last-child{border-bottom:none}
.slash-item:hover,.slash-item.sel{background:var(--card2)}
.slash-item.sel{border-left:2px solid var(--accent)}
.slash-cmd{
  font-family:var(--fm);font-size:11px;color:var(--t2);
  min-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.slash-cmd .hl{color:var(--accent);font-weight:600}
.slash-desc{
  font-size:10px;color:var(--t3);flex:1;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.slash-tag{
  font-family:var(--fd);font-size:8px;letter-spacing:0.06em;
  padding:1px 5px;border-radius:3px;flex-shrink:0;
}
.slash-tag.AI  {background:rgba(61,143,255,0.12);color:var(--accent2)}
.slash-tag.ENG {background:rgba(0,224,154,0.1);color:var(--green)}
.slash-tag.OPS {background:rgba(255,170,0,0.1);color:var(--amber)}
.slash-tag.DATA{background:rgba(0,200,240,0.1);color:var(--cyan)}
.slash-tag.UI  {background:rgba(255,68,85,0.08);color:#ff8899}
.slash-tag.ON  {background:rgba(0,224,154,0.15);color:var(--green);border:1px solid rgba(0,224,154,0.3)}

/* ── TOOL FORM (inline in chat bubble) ─────────────────────── */
.tc-tool{cursor:pointer}  /* override cursor:default set earlier */
.tc-tool:hover .tc-tname{color:var(--t1)}
.tool-form{margin-top:10px;display:flex;flex-direction:column;gap:0}
.tf-group{margin-bottom:11px}
.tf-label{
  font-family:var(--fd);font-size:10px;font-weight:600;
  letter-spacing:0.09em;text-transform:uppercase;
  color:var(--t2);margin-bottom:5px;display:flex;align-items:center;gap:5px;
}
.tf-req{color:var(--red);font-size:10px;font-weight:400}
.tf-opt{color:var(--t3);font-size:10px;font-weight:400}
.tf-input,.tf-select{
  width:100%;padding:7px 10px;
  background:var(--card2);border:1px solid var(--bdr2);border-radius:4px;
  color:var(--t1);font-family:var(--fm);font-size:12px;
  outline:none;transition:border-color .15s;box-sizing:border-box;
}
.tf-input:focus,.tf-select:focus{border-color:var(--accent)}
.tf-input.tf-err{border-color:var(--red)}
.tf-select{cursor:pointer;background-color:var(--card2)}
.tf-hint{font-size:10px;color:var(--t3);margin-top:3px;font-family:var(--fd);line-height:1.5}
.tf-submit{
  margin-top:6px;padding:9px 0;width:100%;
  background:var(--accent);color:#fff;border:none;border-radius:4px;
  font-family:var(--fd);font-size:11px;font-weight:600;letter-spacing:0.1em;
  text-transform:uppercase;cursor:pointer;transition:opacity .15s;
}
.tf-submit:hover{opacity:.85}
.tf-submit:disabled{opacity:.35;cursor:not-allowed}
.tf-result{
  margin-top:10px;padding:8px 10px;
  background:var(--card);border:1px solid var(--bdr);border-radius:4px;
  font-family:var(--fm);font-size:11px;color:var(--t1);
  white-space:pre-wrap;word-break:break-word;max-height:260px;overflow-y:auto;
}
.tf-result.err{border-color:var(--red);color:var(--red)}

/* ── BOTTOM FLANKS ──────────────────────────────────────────── */
.lb{
  grid-column:1;grid-row:3;
  background:var(--surf);border-top:1px solid var(--bdr);border-right:1px solid var(--bdr);
  display:flex;align-items:center;justify-content:center;
}
.lb span{
  font-family:var(--fd);font-size:10px;color:var(--t3);
  letter-spacing:0.12em;text-transform:uppercase;
}

.rb{
  grid-column:3;grid-row:3;
  background:var(--surf);border-top:1px solid var(--bdr);
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;gap:3px;
}
.rb span{
  font-family:var(--fd);font-size:10px;color:var(--t3);
  letter-spacing:0.1em;text-transform:uppercase;
}
.rb .ver{color:var(--t2);font-size:10px}

/* ── MODAL / ADD SERVER ─────────────────────────────────── */
.modal-bg{
  position:fixed;inset:0;background:rgba(4,7,18,0.85);
  display:none;align-items:center;justify-content:center;z-index:100;
}
.modal-bg.open{display:flex}
.modal{
  background:var(--surf);border:1px solid var(--bdr2);border-radius:8px;
  padding:24px;width:420px;
}
.modal-title{
  font-family:var(--fd);font-size:13px;font-weight:700;
  letter-spacing:0.1em;text-transform:uppercase;color:var(--t1);
  margin-bottom:16px;
}
.modal pre{
  background:var(--card);border:1px solid var(--bdr);border-radius:6px;
  padding:12px;font-size:11px;color:var(--cyan);line-height:1.7;
  overflow-x:auto;margin-bottom:16px;
}
.modal-close{
  padding:6px 16px;background:transparent;border:1px solid var(--bdr2);
  border-radius:4px;color:var(--t2);font-family:var(--fd);font-size:10px;
  font-weight:600;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;
  transition:all .15s;
}
.modal-close:hover{border-color:var(--accent);color:var(--accent2)}

/* ── LLM PICKER MODAL ───────────────────────────────────── */
.llm-modal-bg{
  position:fixed;inset:0;background:rgba(4,7,18,0.88);
  display:none;align-items:center;justify-content:center;z-index:110;
}
.llm-modal-bg.open{display:flex}
.llm-modal{
  background:var(--surf);border:1px solid var(--bdr2);border-radius:8px;
  padding:22px;width:460px;max-height:78vh;display:flex;flex-direction:column;
}
.llm-modal-title{
  font-family:var(--fd);font-size:12px;font-weight:700;
  letter-spacing:0.12em;text-transform:uppercase;color:var(--t1);
  margin-bottom:4px;
}
.llm-modal-sub{font-size:11px;color:var(--t2);margin-bottom:14px}
.llm-search{
  width:100%;background:var(--card);border:1px solid var(--bdr);
  border-radius:4px;padding:7px 11px;color:var(--t1);
  font-family:var(--fm);font-size:12px;outline:none;
  transition:border-color .15s;margin-bottom:10px;flex-shrink:0;
}
.llm-search:focus{border-color:var(--bdr3)}
.llm-search::placeholder{color:var(--t3)}
.model-list{
  overflow-y:auto;flex:1;display:flex;flex-direction:column;gap:3px;
}
.model-list::-webkit-scrollbar{width:3px}
.model-list::-webkit-scrollbar-thumb{background:var(--bdr2);border-radius:2px}
.model-group-label{
  font-family:var(--fd);font-size:9px;font-weight:700;
  letter-spacing:0.2em;text-transform:uppercase;color:var(--t3);
  padding:6px 4px 3px;
}
.model-item{
  display:flex;align-items:center;gap:10px;
  padding:9px 12px;border-radius:5px;cursor:pointer;
  border:1px solid transparent;transition:all .12s;
}
.model-item:hover{background:var(--card2);border-color:var(--bdr)}
.model-item.active{
  background:rgba(61,143,255,0.08);
  border-color:rgba(61,143,255,0.35);
}
.model-item.loading{opacity:.5;pointer-events:none}
.model-item.not-pulled{opacity:.6}
.model-item.not-pulled:hover{opacity:1;border-color:rgba(255,170,0,0.35);background:rgba(255,170,0,0.04)}
.mi-name{
  font-family:var(--fm);font-size:12px;color:var(--t1);
  flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.mi-desc{
  font-size:10px;color:var(--t3);font-family:var(--fd);
  width:100%;padding-top:2px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.mi-size{
  font-size:10px;color:var(--t3);font-family:var(--fd);
  letter-spacing:0.05em;flex-shrink:0;
}
.mi-check{
  width:14px;height:14px;flex-shrink:0;color:var(--green);
}
.mi-dl{
  width:14px;height:14px;flex-shrink:0;color:var(--amber);
}
.mi-prov{
  font-size:9px;padding:2px 6px;border-radius:3px;
  font-family:var(--fd);letter-spacing:0.05em;text-transform:uppercase;
  background:rgba(0,200,240,0.1);color:var(--cyan);flex-shrink:0;
}
.mi-badge{
  font-size:9px;padding:2px 6px;border-radius:3px;
  font-family:var(--fd);letter-spacing:0.05em;text-transform:uppercase;
  background:rgba(255,170,0,0.12);color:var(--amber);flex-shrink:0;
}
/* Pull progress bar inside status msg */
.pull-bar-wrap{
  width:100%;height:4px;background:var(--bdr);border-radius:2px;margin-top:6px;
}
.pull-bar{
  height:4px;border-radius:2px;background:var(--accent);
  transition:width .3s;width:0%;
}
.llm-modal-footer{
  display:flex;align-items:center;justify-content:space-between;
  margin-top:14px;padding-top:12px;border-top:1px solid var(--bdr);
  flex-shrink:0;
}
.llm-status-msg{font-size:11px;color:var(--t2);font-family:var(--fm)}
.llm-status-msg.ok{color:var(--green)}
.llm-status-msg.err{color:var(--red)}
.llm-close-btn{
  padding:5px 14px;background:transparent;border:1px solid var(--bdr2);
  border-radius:4px;color:var(--t2);font-family:var(--fd);font-size:10px;
  font-weight:600;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;
  transition:all .15s;
}
.llm-close-btn:hover{border-color:var(--accent);color:var(--accent2)}
.llm-pill-btn{cursor:pointer;transition:border-color .15s}
.llm-pill-btn:hover{border-color:var(--accent2)!important}

/* boot overlay */
.boot-overlay{
  position:fixed;inset:0;background:var(--bg);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:18px;z-index:200;transition:opacity .4s;
}
.boot-overlay.hidden{opacity:0;pointer-events:none}
.boot-logo{
  font-family:var(--fd);font-size:22px;font-weight:700;
  letter-spacing:0.2em;color:var(--t1);text-transform:uppercase;
}
.boot-status{
  font-family:var(--fm);font-size:11px;color:var(--t2);
}
.boot-bar{
  width:220px;height:2px;background:var(--bdr);border-radius:2px;overflow:hidden;
}
.boot-fill{
  height:100%;background:var(--accent);border-radius:2px;
  animation:bootfill 2s ease-in-out infinite alternate;
}
@keyframes bootfill{from{width:5%}to{width:90%}}

/* ── File Viewer Modal ─────────────────────────────────────── */
.fv-modal-bg{
  position:fixed;inset:0;background:rgba(4,7,18,0.92);
  display:none;align-items:flex-start;justify-content:center;
  z-index:120;padding:24px;box-sizing:border-box;
}
.fv-modal-bg.open{display:flex}
.fv-panel{
  background:var(--surf);border:1px solid var(--bdr2);border-radius:8px;
  width:100%;max-width:1100px;max-height:calc(100vh - 48px);
  display:flex;flex-direction:column;overflow:hidden;
}
.fv-header{
  padding:14px 18px 10px;border-bottom:1px solid var(--bdr);
  display:flex;flex-direction:column;gap:8px;flex-shrink:0;
}
.fv-title{
  font-family:var(--fd);font-size:11px;font-weight:700;
  letter-spacing:0.14em;text-transform:uppercase;color:var(--t2);
}
.fv-path-row{display:flex;gap:8px}
.fv-path-input{
  flex:1;background:var(--card);border:1px solid var(--bdr);
  border-radius:4px;padding:7px 11px;color:var(--t1);
  font-family:var(--fm);font-size:12px;outline:none;
  transition:border-color .15s;
}
.fv-path-input:focus{border-color:var(--bdr3)}
.fv-path-input::placeholder{color:var(--t3)}
.fv-controls-row{display:flex;align-items:center;gap:10px}
.fv-label{font-size:11px;color:var(--t2);display:flex;align-items:center;gap:6px}
.fv-select{
  background:var(--card);border:1px solid var(--bdr);border-radius:3px;
  color:var(--t1);font-family:var(--fm);font-size:11px;padding:3px 6px;
}
.fv-btn{
  padding:5px 13px;background:transparent;border:1px solid var(--bdr2);
  border-radius:4px;color:var(--t2);font-family:var(--fd);font-size:10px;
  font-weight:600;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;
  transition:all .15s;white-space:nowrap;
}
.fv-btn:hover{border-color:var(--accent);color:var(--accent2)}
.fv-btn.fv-close{margin-left:auto;border-color:transparent}
.fv-btn.fv-close:hover{border-color:var(--red);color:var(--red)}
.fv-drop-zone{
  margin:0;padding:40px 24px;
  display:flex;flex-direction:column;align-items:center;gap:8px;
  border:1px dashed var(--bdr2);border-radius:6px;
  margin:12px 18px;cursor:pointer;transition:all .15s;
  flex-shrink:0;
}
.fv-drop-zone.drag-over{border-color:var(--accent);background:rgba(61,143,255,0.05)}
.fv-drop-icon{font-size:28px;color:var(--t3)}
.fv-drop-hint{font-family:var(--fd);font-size:12px;color:var(--t2);letter-spacing:0.05em}
.fv-drop-types{font-size:10px;color:var(--t3);font-family:var(--fd)}
.fv-sheet-tabs{
  display:flex;gap:2px;padding:0 18px;flex-shrink:0;
  border-bottom:1px solid var(--bdr);overflow-x:auto;
}
.fv-sheet-tab{
  padding:6px 14px;font-family:var(--fd);font-size:10px;
  font-weight:600;letter-spacing:0.1em;text-transform:uppercase;
  color:var(--t3);background:transparent;border:none;
  border-bottom:2px solid transparent;cursor:pointer;
  transition:all .12s;white-space:nowrap;
}
.fv-sheet-tab:hover{color:var(--t1)}
.fv-sheet-tab.active{color:var(--accent2);border-bottom-color:var(--accent)}
.fv-content-wrap{
  flex:1;overflow:auto;position:relative;
}
.fv-content-wrap::-webkit-scrollbar{width:5px;height:5px}
.fv-content-wrap::-webkit-scrollbar-thumb{background:var(--bdr2);border-radius:2px}
.fv-content{min-height:100%}
.fv-table{
  border-collapse:collapse;font-family:var(--fm);font-size:12px;
  color:var(--t1);width:100%;
}
.fv-table th{
  position:sticky;top:0;background:var(--card);
  padding:7px 12px;text-align:left;font-weight:600;
  border-bottom:1px solid var(--bdr2);white-space:nowrap;
  color:var(--t2);font-size:11px;
}
.fv-table td{
  padding:5px 12px;border-bottom:1px solid var(--bdr);
  white-space:nowrap;max-width:320px;
  overflow:hidden;text-overflow:ellipsis;
}
.fv-table tr:hover td{background:var(--card)}
.fv-row-num{
  color:var(--t3)!important;font-size:10px!important;
  width:40px;min-width:40px;text-align:right!important;
  user-select:none;background:var(--bg)!important;
  position:sticky;left:0;
}
.fv-code{
  margin:0;padding:20px 24px;
  font-family:var(--fm);font-size:12px;line-height:1.6;
  color:var(--t1);white-space:pre-wrap;word-break:break-word;
}
.fv-spinner{
  display:flex;align-items:center;justify-content:center;
  padding:60px;font-size:28px;color:var(--t3);
  animation:spin 1s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}
.fv-statusbar{
  padding:6px 18px;border-top:1px solid var(--bdr);
  font-family:var(--fd);font-size:10px;color:var(--t3);
  letter-spacing:0.05em;flex-shrink:0;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;
}
</style>
</head>
<body>
<div class="scanlines"></div>

<!-- BOOT OVERLAY -->
<div class="boot-overlay" id="boot-overlay">
  <div class="boot-logo">
    <svg width="32" height="32" viewBox="0 0 26 26" fill="none" style="vertical-align:middle;margin-right:10px">
      <ellipse cx="13" cy="16" rx="8" ry="9.5" fill="#d4e5ff"/>
      <ellipse cx="13" cy="17.5" rx="5" ry="6.5" fill="#070c1a"/>
      <ellipse cx="13" cy="19" rx="3.2" ry="4.5" fill="#d4e5ff"/>
      <circle cx="13" cy="8" r="6.5" fill="#070c1a"/>
      <circle cx="10.5" cy="7.2" r="1.7" fill="#d4e5ff"/>
      <circle cx="15.5" cy="7.2" r="1.7" fill="#d4e5ff"/>
      <circle cx="10.5" cy="7.2" r=".85" fill="#070c1a"/>
      <circle cx="15.5" cy="7.2" r=".85" fill="#070c1a"/>
      <polygon points="13,9.5 11.5,12 14.5,12" fill="#ffaa00"/>
    </svg>
    Iceberg
  </div>
  <div class="boot-bar"><div class="boot-fill"></div></div>
  <div class="boot-status" id="boot-status">Connecting to backend…</div>
</div>

<!-- LLM PICKER MODAL -->
<div class="llm-modal-bg" id="llm-modal">
  <div class="llm-modal">
    <div class="llm-modal-title">Select Model</div>
    <div class="llm-modal-sub" id="llm-modal-sub">Loading available models…</div>
    <input class="llm-search" type="text" id="llm-search" placeholder="filter models…" oninput="filterModels(this.value)">
    <div class="model-list" id="model-list">
      <div style="font-size:11px;color:var(--t3);padding:8px 4px">Querying Ollama…</div>
    </div>
    <div class="llm-modal-footer">
      <span class="llm-status-msg" id="llm-status-msg"></span>
      <button class="llm-close-btn" onclick="closeLLMPicker()">close</button>
    </div>
  </div>
</div>

<!-- ADD SERVER MODAL -->
<div class="modal-bg" id="modal">
  <div class="modal">
    <div class="modal-title">Connect MCP Server</div>
    <p style="font-size:12px;color:var(--t2);margin-bottom:14px;line-height:1.6">
      Select a server to add. Iceberg will restart after adding.
    </p>
    <div id="mcp-catalog-list" style="max-height:400px;overflow-y:auto">
      <div style="font-size:11px;color:var(--t3);padding:8px 4px">Loading catalog…</div>
    </div>
    <button class="modal-close" onclick="closeModal()">close</button>
  </div>
</div>

<!-- API KEY INPUT MODAL -->
<div class="modal-bg" id="api-key-modal" style="display:none">
  <div class="modal">
    <div class="modal-title" id="api-key-title">Enter API Key</div>
    <p style="font-size:12px;color:var(--t2);margin-bottom:14px;line-height:1.6" id="api-key-label">
      This server requires an API key.
    </p>
    <input type="text" id="api-key-input" placeholder="Enter your key here" 
           style="width:100%;padding:10px;background:var(--card);border:1px solid var(--bdr);border-radius:4px;color:var(--t1);font-family:var(--fm);font-size:12px;margin-bottom:14px">
    <div style="display:flex;gap:10px;justify-content:flex-end">
      <button class="modal-close" onclick="closeApiKeyModal()">cancel</button>
      <button class="modal-close" onclick="submitApiKey()" style="background:var(--accent);color:#fff">add server</button>
    </div>
  </div>
</div>

<!-- RESTART CONFIRMATION MODAL -->
<div class="modal-bg" id="restart-modal" style="display:none">
  <div class="modal">
    <div class="modal-title">Restart Required</div>
    <p style="font-size:12px;color:var(--t2);margin-bottom:14px;line-height:1.6">
      Server added successfully! Iceberg needs to restart to load the new MCP server.
    </p>
    <p style="font-size:12px;color:var(--green);margin-bottom:14px">
      ✓ <span id="restart-server-name"></span> added to config.json
    </p>
    <p style="font-size:12px;color:var(--t2);margin-bottom:20px">
      Would you like to restart now?
    </p>
    <div style="display:flex;gap:10px;justify-content:flex-end">
      <button class="modal-close" onclick="closeRestartModal()">no, restart later</button>
      <button class="modal-close" onclick="restartNow()" style="background:var(--accent);color:#fff">yes, restart now</button>
    </div>
  </div>
</div>

<!-- NPX MISSING MODAL -->
<div class="modal-bg" id="npx-missing-modal" style="display:none">
  <div class="modal">
    <div class="modal-title">Node.js Required</div>
    <p style="font-size:12px;color:var(--t2);margin-bottom:14px;line-height:1.6">
      MCP servers require Node.js and npx to run, but they're not installed on your system.
    </p>
    <p style="font-size:12px;color:var(--t3);margin-bottom:20px;line-height:1.6">
      Node.js is free and open-source. Installing it will give you access to thousands of MCP servers.
    </p>
    <p style="font-size:12px;color:var(--t2);margin-bottom:20px;font-weight:600">
      Would you like to download and install Node.js now?
    </p>
    <div style="display:flex;gap:10px;justify-content:flex-end">
      <button class="modal-close" onclick="closeNpxMissingModal()">no, maybe later</button>
      <button class="modal-close" onclick="openNodeJsDownload()" style="background:var(--accent);color:#fff">yes, download Node.js</button>
    </div>
  </div>
</div>

<!-- INSTALL SKILL MODAL -->
<div class="modal-bg" id="install-skill-modal" style="display:none">
  <div class="modal" style="max-width:480px">
    <div class="modal-title">Install Skill</div>
    <p style="font-size:12px;color:var(--t2);margin-bottom:14px;line-height:1.6">
      Paste the full path to a skill directory on disk. The folder will be copied into
      <code style="color:var(--accent2);font-size:11px">Project-Iceberg/Skills/</code> and immediately available.
    </p>
    <input id="install-skill-path"
           style="width:100%;padding:10px;background:var(--card);border:1px solid var(--bdr);border-radius:4px;
                  color:var(--t1);font-family:var(--fm);font-size:12px;margin-bottom:6px;outline:none"
           placeholder="e.g. D:\Skills\debugging-wizard"
           onkeydown="if(event.key==='Enter')doInstallSkill()">
    <div id="install-skill-err" style="font-size:11px;color:var(--red);min-height:18px;margin-bottom:8px"></div>
    <div style="display:flex;gap:10px;justify-content:flex-end">
      <button class="modal-close" onclick="closeInstallModal()">cancel</button>
      <button class="modal-close" id="install-skill-btn"
              onclick="doInstallSkill()"
              style="background:var(--accent);color:#fff">install</button>
    </div>
  </div>
</div>

<div class="shell">

<!-- ── TOPBAR ── -->
<header class="topbar">
  <div class="logo">
    <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
      <ellipse cx="13" cy="16" rx="8" ry="9.5" fill="#d4e5ff"/>
      <ellipse cx="13" cy="17.5" rx="5" ry="6.5" fill="#0b1124"/>
      <ellipse cx="13" cy="19" rx="3.2" ry="4.5" fill="#d4e5ff"/>
      <circle cx="13" cy="8" r="6.5" fill="#0b1124"/>
      <circle cx="10.5" cy="7.2" r="1.7" fill="#d4e5ff"/>
      <circle cx="15.5" cy="7.2" r="1.7" fill="#d4e5ff"/>
      <circle cx="10.5" cy="7.2" r=".85" fill="#0b1124"/>
      <circle cx="15.5" cy="7.2" r=".85" fill="#0b1124"/>
      <polygon points="13,9.5 11.5,12 14.5,12" fill="#ffaa00"/>
    </svg>
    Iceberg
  </div>

  <div class="pill llm-pill-btn" onclick="openLLMPicker()" title="Click to switch model">
    <span class="pdot off" id="llm-dot"></span>
    <span>LLM</span>
    <span class="pval" id="llm-val">—</span>
    <svg width="8" height="8" viewBox="0 0 8 8" fill="none" style="margin-left:2px;opacity:.4">
      <path d="M1 2.5l3 3 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <div class="pill">
    <span class="pdot off" id="mcp-dot"></span>
    <span>MCP</span>
    <span class="pval" id="mcp-val">—</span>
  </div>

  <div class="pill">
    <span class="pdot off" id="tools-dot"></span>
    <span>Tools</span>
    <span class="pval" id="tools-val">—</span>
  </div>

  <div class="pill">
    <span>Memory</span>
    <span class="pval" id="memory-val">—</span>
  </div>

  <div class="spacer"></div>

  <button class="tbtn" id="voice-btn" onclick="toggleVoice()">⬤ voice</button>
  <button class="tbtn" onclick="openModal()">+ server</button>
  <button class="tbtn" onclick="openFileViewer()">◫ viewer</button>
  <button class="tbtn danger" id="reset-btn" onclick="resetChat()">reset</button>
</header>

<!-- ── LEFT PANEL ── -->
<aside class="lp">
  <!-- Tab bar -->
  <div class="lp-tabs">
    <button class="lp-tab active" id="tab-servers" onclick="switchTab('servers')">Servers</button>
    <button class="lp-tab" id="tab-skills" onclick="switchTab('skills')">Skills</button>
  </div>

  <!-- Servers pane -->
  <div class="lp-pane" id="pane-servers">
    <div class="plabel">MCP Servers</div>
    <div id="srv-list">
      <div style="font-size:11px;color:var(--t3);padding:8px 4px">Connecting…</div>
    </div>
    <div class="divider"></div>
    <div class="plabel" style="margin-top:2px">Add Server</div>
    <button class="add-btn" onclick="openModal()">+ connect mcp server</button>
    <div style="flex:1"></div>
    <div style="padding:4px 4px 0;font-family:var(--fd);font-size:10px;color:var(--t3);letter-spacing:0.1em;text-transform:uppercase;line-height:1.8">
      local-first · private<br>offline-capable
    </div>
  </div>

  <!-- Skills pane -->
  <div class="lp-pane hidden" id="pane-skills">
    <div style="display:flex;align-items:center;margin-bottom:4px">
      <div class="plabel" style="flex:1;margin-bottom:0">Skills</div>
      <button class="sk-install-btn" onclick="openInstallModal()" title="Install a skill from disk">+</button>
    </div>
    <input class="sinput" id="sk-search" type="text" placeholder="filter skills…" oninput="filterSkills(this.value)">
    <div id="sk-active-hdr" class="sk-active-hdr" style="display:none">
      <span class="sk-active-dot"></span>
      <span id="sk-active-count">0 active</span>
    </div>
    <div id="sk-list"><div style="font-size:11px;color:var(--t3);padding:8px 4px">Loading skills…</div></div>
  </div>
</aside>

<!-- ── CHAT ── -->
<main class="cc">
  <div class="msgs" id="msgs">
    <div class="msg a">
      <div class="mmeta">Iceberg</div>
      <div class="mbubble">
        <span id="welcome-msg" style="color:var(--t2)">Connecting to backend…</span>
      </div>
    </div>
  </div>
</main>

<!-- ── RIGHT PANEL ── -->
<aside class="rp">
  <div class="plabel">Tool Registry</div>
  <input class="sinput" type="text" placeholder="filter tools…" id="tsearch" oninput="filterTools(this.value)">
  <div id="tlist">
    <div style="font-size:11px;color:var(--t3);padding:4px">Loading…</div>
  </div>
</aside>

<!-- ── BOTTOM ROW ── -->
<div class="lb"><span>local-first · offline-capable</span></div>

<div class="ib">
  <div id="sk-strip" class="sk-strip-bar" style="display:none">
    <span class="sk-strip-label">Skills:</span>
    <div id="sk-strip-pills"></div>
  </div>
  <textarea class="cinput" id="cinput" placeholder="ask anything or use / for skills…" onkeydown="handleKey(event)" oninput="handleInputChange(event)" rows="1"></textarea>
  <button class="ibtn" id="vbtn" title="Voice input" onclick="toggleVoice()">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
      <rect x="4.5" y="1" width="5" height="8" rx="2.5" fill="currentColor"/>
      <path d="M2 7c0 2.76 2.24 5 5 5s5-2.24 5-5" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/>
      <line x1="7" y1="12" x2="7" y2="14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
  </button>
  <button class="ibtn send" id="send-btn" onclick="sendMsg()" title="Send (Enter)">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
      <path d="M1 7h12M8 2l5 5-5 5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</div>

<div class="rb">
  <span class="ver">ICEBERG</span>
  <span>v2.0 · mcp ready</span>
</div>

</div><!-- .shell -->

<script>
// ── State ────────────────────────────────────────────────────
const expanded = {};
let isSending = false;
let voiceOn = false;

// ── Helpers ──────────────────────────────────────────────────
function esc(s) {
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function setInputEnabled(on) {
  const inp = document.getElementById('cinput');
  const btn = document.getElementById('send-btn');
  inp.disabled = !on;
  btn.disabled = !on;
  if (!on) btn.classList.add('disabled');
  else btn.classList.remove('disabled');
}

// ── Boot sequence ────────────────────────────────────────────
// Poll /api/ready until the agent is up, then load everything.
async function pollReady() {
  const el = document.getElementById('boot-status');
  let attempts = 0;
  while (true) {
    try {
      const res = await fetch('/api/ready');
      const d = await res.json();
      if (d.ready) {
        if (d.error) {
          el.textContent = 'Agent error: ' + d.error;
          el.style.color = 'var(--red)';
          return false;
        }
        return true;
      }
    } catch(e) {
      // server not up yet — normal on first load
    }
    attempts++;
    const msgs = ['Connecting to backend…', 'Loading LLM…', 'Discovering MCP servers…', 'Registering tools…', 'Almost ready…'];
    el.textContent = msgs[Math.min(Math.floor(attempts / 3), msgs.length - 1)];
    await new Promise(r => setTimeout(r, 800));
  }
}

async function boot() {
  const ok = await pollReady();
  const overlay = document.getElementById('boot-overlay');
  overlay.classList.add('hidden');
  setTimeout(() => overlay.style.display = 'none', 500);

  if (!ok) return;

  // Load all live data in parallel — skills loads silently in background
  await Promise.all([loadStatus(), loadServers(), loadTools()]);
  loadSkills(); // non-blocking: populates SKILLS_CATALOG for slash popup
  setInputEnabled(true);
}

// ── Status pills ─────────────────────────────────────────────
async function loadStatus() {
  try {
    const res = await fetch('/api/status');
    if (!res.ok) return;
    const d = await res.json();

    document.getElementById('llm-val').textContent = d.llm;
    document.getElementById('llm-dot').className = 'pdot ' + (d.llm_active ? 'g' : 'off');
    document.getElementById('mcp-dot').className = 'pdot ' + (d.mcp_servers.length > 0 ? 'g' : 'off');
    document.getElementById('mcp-val').textContent = d.mcp_servers.length + ' connected';
    document.getElementById('tools-dot').className = 'pdot ' + (d.tools_count > 0 ? 'g' : 'off');
    document.getElementById('tools-val').textContent = d.tools_count + ' registered';
    document.getElementById('memory-val').textContent = d.memory_count + ' entr' + (d.memory_count === 1 ? 'y' : 'ies');

    const wm = document.getElementById('welcome-msg');
    if (wm) {
      const mcpStr = d.mcp_servers.length
        ? 'MCP: <span style="color:var(--accent2)">' + esc(d.mcp_servers.join(', ')) + '</span>. '
        : '';
      wm.innerHTML =
        'Ready. LLM: <span style="color:var(--accent2)">' + esc(d.llm) + '</span>. ' +
        mcpStr +
        '<span style="color:var(--t2)">' + d.tools_count + ' tools. Type anything.</span>';
    }
  } catch(e) {
    console.warn('[status]', e);
  }
}

// ── MCP server cards ─────────────────────────────────────────
function toggleSrv(n) {
  expanded[n] = !expanded[n];
  const el = document.getElementById('srv-' + n);
  if (el) el.classList.toggle('expanded', !!expanded[n]);
}

async function loadServers() {
  try {
    const res = await fetch('/api/servers');
    if (!res.ok) return;
    const servers = await res.json();
    renderServers(servers);
  } catch(e) {
    console.warn('[servers]', e);
  }
}

function renderServers(servers) {
  const sl = document.getElementById('srv-list');
  if (!servers.length) {
    sl.innerHTML =
      '<div style="font-size:11px;color:var(--t3);padding:8px 4px;line-height:1.9">' +
      'No servers connected.<br>Add one in config.json<br>and restart.</div>';
    return;
  }
  sl.innerHTML = servers.map(srv => {
    const toolsHtml = srv.tools.slice(0, 6)
      .map(t => '<div class="sc-tool">' + esc(srv.name) + '__' + esc(t) + '</div>')
      .join('');
    const moreHtml = srv.tools.length > 6
      ? '<div class="sc-more">+' + (srv.tools.length - 6) + ' more</div>'
      : '';
    return `
      <div class="sc" id="srv-${esc(srv.name)}" onclick="toggleSrv('${esc(srv.name)}')">
        <div class="sc-head">
          <span class="sc-name">${esc(srv.name)}</span>
          <div class="sc-status"><span class="sdot on"></span>connected</div>
        </div>
        <div class="sc-count">Tools: <span>${srv.tools.length}</span></div>
        <div class="sc-tools" id="st-${esc(srv.name)}">
          ${toolsHtml}${moreHtml}
        </div>
      </div>`;
  }).join('');
}

// ── Tool registry ─────────────────────────────────────────────

// Category metadata: display name, icon, dot colour, sort order.
const CAT_META = {
  networking:  { label: 'Networking',  icon: '◈', color: '#00c8f0', order: 0 },
  file_system: { label: 'File System', icon: '◫', color: '#6ab0ff', order: 1 },
  system:      { label: 'System',      icon: '⬡', color: '#ffaa00', order: 2 },
  custom:      { label: 'Custom',      icon: '⬟', color: '#00e09a', order: 3 },
  reasoning:   { label: 'Reasoning',   icon: '◉', color: '#d4e5ff', order: 10 },
  memory:      { label: 'Memory',      icon: '◈', color: '#ffaa00', order: 11 },
  github:      { label: 'GitHub',      icon: '⬟', color: '#00e09a', order: 12 },
};

// Categories open by default on first render.
const CAT_OPEN_DEFAULT = new Set(['networking']);

// Per-category open state (persists across filter resets).
const _catOpen = {};

function catKeyFromTool(t) {
  if (t.category === 'web')    return 'networking';
  if (t.category === 'file')   return 'file_system';
  if (t.category === 'system') return 'system';
  if (t.category === 'custom') return 'custom';
  if (t.category === 'mcp') {
    const srv = t.name.split('__')[0].toLowerCase().replace(/-/g, '_');
    if (srv === 'sequential_thinking') return 'reasoning';
    return srv;
  }
  return 'other';
}

function catMeta(key) {
  return CAT_META[key] || {
    label: key.replace(/_/g, ' '),
    icon: '⬡',
    color: 'var(--t2)',
    order: 99,
  };
}

function toggleCategory(key) {
  _catOpen[key] = !_catOpen[key];
  const group = document.getElementById('tcg-' + key);
  if (group) group.classList.toggle('open', !!_catOpen[key]);
}

function filterTools(q) {
  q = q.toLowerCase().trim();
  document.querySelectorAll('#tlist .tc-group').forEach(group => {
    const key = group.id.replace('tcg-', '');
    if (!q) {
      // Restore user's saved open/closed state for each category.
      group.classList.toggle('open', !!_catOpen[key]);
      group.classList.remove('tc-hidden');
      group.querySelectorAll('.tc-tool').forEach(r => r.classList.remove('tc-hidden'));
      return;
    }
    // Active search: expand all groups, hide non-matching tools.
    let anyVisible = false;
    group.querySelectorAll('.tc-tool').forEach(r => {
      const match = (r.dataset.name || '').toLowerCase().includes(q);
      r.classList.toggle('tc-hidden', !match);
      if (match) anyVisible = true;
    });
    group.classList.toggle('tc-hidden', !anyVisible);
    if (anyVisible) group.classList.add('open');
  });
}

async function loadTools() {
  try {
    const res = await fetch('/api/tools');
    if (!res.ok) return;
    const tools = await res.json();
    renderTools(tools);
  } catch(e) {
    console.warn('[tools]', e);
  }
}

// Full tool list keyed by name — populated in renderTools(), used by openToolForm()
const _allTools = {};

function renderTools(tools) {
  // Store full tool metadata for form generation
  tools.forEach(t => { _allTools[t.name] = t; });

  // Group tools by resolved category key.
  const groups = {};
  tools.forEach(t => {
    const key = catKeyFromTool(t);
    if (!groups[key]) groups[key] = [];
    groups[key].push(t);
  });

  // Sort groups: defined order first, then unknowns alphabetically.
  const keys = Object.keys(groups).sort((a, b) => {
    const oa = catMeta(a).order ?? 99;
    const ob = catMeta(b).order ?? 99;
    if (oa !== ob) return oa - ob;
    return a.localeCompare(b);
  });

  const tlist = document.getElementById('tlist');
  tlist.innerHTML = keys.map(key => {
    const meta = catMeta(key);
    const isOpen = CAT_OPEN_DEFAULT.has(key);
    if (isOpen) _catOpen[key] = true;

    const toolRows = groups[key].map(t =>
      `<div class="tc-tool" data-name="${esc(t.name)}"
            title="Click to use · ${esc(t.description || t.name)}"
            onclick="openToolForm('${esc(t.name)}')">` +
        `<span class="tc-dot" style="background:${meta.color}"></span>` +
        `<span class="tc-tname">${esc(t.name)}</span>` +
      `</div>`
    ).join('');

    return `
      <div class="tc-group${isOpen ? ' open' : ''}" id="tcg-${esc(key)}">
        <div class="tc-header" onclick="toggleCategory('${esc(key)}')">
          <span class="tc-arrow">▸</span>
          <span class="tc-icon" style="color:${meta.color}">${meta.icon}</span>
          <span class="tc-label">${esc(meta.label)}</span>
          <span class="tc-count">${groups[key].length}</span>
        </div>
        <div class="tc-body">${toolRows}</div>
      </div>`;
  }).join('');
}

// ── Tool Form System ───────────────────────────────────────────
// Maps tool names to friendly opening lines for the chat bubble.
const _TOOL_GREETINGS = {
  scrape_paginated: "Web Scrape? Ok! I need a little more info…",
  web_search:       "Sure! What should I search for?",
  read_file:        "Reading a file — which one?",
  create_file:      "Creating a file — set it up below.",
  delete_file:      "⚠ Deleting a file — confirm the details.",
  move_file:        "Moving a file — source and destination?",
  append_file:      "Appending to a file — fill in the details.",
  list_dir:         "Listing a directory — which path?",
  scan:             "Directory scan — configure below.",
};

// Human-readable labels for known arg names.
const _TF_LABELS = {
  url:          'Target URL',
  path:         'File / Directory Path',
  src:          'Source Path',
  dst:          'Destination Path',
  query:        'Search Query',
  selector:     'CSS Selector',
  extract:      'Extract Mode',
  pagination:   'Pagination Type',
  max_pages:    'Max Pages',
  next_button:  'Next Button Selector',
  content:      'File Content',
  mode:         'Scan Mode',
};

function _tfLabel(name) {
  return _TF_LABELS[name] ||
    name.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

// Build one form-field group for an arg descriptor.
function _buildFormField(arg, formId) {
  const inputId = `${formId}__${arg.name}`;
  const reqBadge = arg.required
    ? '<span class="tf-req">required</span>'
    : '<span class="tf-opt">optional</span>';

  let control = '';
  switch (arg.name) {
    case 'extract':
      control = `<select class="tf-select" id="${inputId}">
        <option value="text">text — visible text content</option>
        <option value="href">href — link URLs</option>
        <option value="html">html — raw HTML</option>
      </select>`;
      break;
    case 'pagination':
      control = `<select class="tf-select" id="${inputId}">
        <option value="auto">auto — detect automatically</option>
        <option value="button">button — click a Next button</option>
        <option value="url">url — URL page pattern</option>
        <option value="scroll">scroll — infinite scroll</option>
      </select>`;
      break;
    case 'mode':
      control = `<select class="tf-select" id="${inputId}">
        <option value="LOW">LOW — directories only</option>
        <option value="MEDIUM" selected>MEDIUM — dirs + files</option>
        <option value="HIGH">HIGH — files + content previews</option>
      </select>`;
      break;
    case 'max_pages':
      control = `<input class="tf-input" type="number" id="${inputId}" value="10" min="1" max="200">`;
      break;
    case 'content':
      control = `<textarea class="tf-input" id="${inputId}" rows="4"
                   style="resize:vertical;font-size:11px"
                   placeholder="${esc(arg.description || '')}"></textarea>`;
      break;
    default:
      control = `<input class="tf-input" type="text" id="${inputId}"
                   placeholder="${esc(arg.description || '')}">`;
  }

  return `
    <div class="tf-group">
      <div class="tf-label">${_tfLabel(arg.name)} ${reqBadge}</div>
      ${control}
    </div>`;
}

// Inject a bot message containing the tool form into the chat.
function openToolForm(toolName) {
  const tool = _allTools[toolName];
  if (!tool) {
    appendMsg('a',
      '<div class="mmeta">Iceberg</div>' +
      `<div class="mbubble" style="color:var(--red)">Unknown tool: ${esc(toolName)}</div>`
    );
    return;
  }

  const greeting = _TOOL_GREETINGS[toolName] ||
    `Running <strong>${esc(toolName)}</strong> — fill in the parameters:`;

  const formId = 'tf_' + toolName.replace(/\W/g, '_') + '_' + Date.now();
  const args   = tool.args || [];
  const fields = args.map(a => _buildFormField(a, formId)).join('');

  const bubble =
    `<div class="mmeta">Iceberg</div>` +
    `<div class="mbubble">` +
      `${greeting}` +
      `<div class="tool-form" id="${formId}">` +
        fields +
        `<button class="tf-submit" onclick="submitToolForm('${esc(toolName)}','${formId}')">` +
          `▶ Run ${esc(toolName)}` +
        `</button>` +
        `<div id="${formId}__result"></div>` +
      `</div>` +
    `</div>`;

  appendMsg('a', bubble);

  // Auto-focus the first input
  setTimeout(() => {
    const first = document.querySelector(`#${formId} .tf-input, #${formId} .tf-select`);
    if (first) first.focus();
  }, 50);
}

// Read inputs, validate, execute tool, display result.
async function submitToolForm(toolName, formId) {
  const tool = _allTools[toolName];
  const args = tool ? (tool.args || []) : [];

  // Collect + validate
  const collected = {};
  let hasError = false;
  for (const arg of args) {
    const el = document.getElementById(`${formId}__${arg.name}`);
    if (!el) continue;
    el.classList.remove('tf-err');
    const val = el.value.trim();
    if (arg.required && !val) {
      el.classList.add('tf-err');
      el.focus();
      hasError = true;
      break;   // Stop at first missing required field
    }
    if (val) collected[arg.name] = val;
  }
  if (hasError) return;

  // Disable the form while running
  const form = document.getElementById(formId);
  if (form) form.querySelectorAll('input,select,textarea,button').forEach(el => el.disabled = true);

  const resultEl = document.getElementById(`${formId}__result`);
  if (resultEl) {
    resultEl.className = 'tf-result';
    resultEl.textContent = 'Running…';
  }

  try {
    const res  = await fetch('/api/tool/run', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ tool: toolName, args: collected }),
    });
    const data = await res.json();

    if (resultEl) {
      if (data.ok) {
        resultEl.className   = 'tf-result';
        resultEl.textContent = data.result || '(no output)';
      } else {
        resultEl.className   = 'tf-result err';
        resultEl.textContent = '✗ ' + (data.error || 'Unknown error');
        // Re-enable form so user can fix and retry
        if (form) form.querySelectorAll('input,select,textarea,button').forEach(el => el.disabled = false);
      }
    }
  } catch (e) {
    if (resultEl) {
      resultEl.className   = 'tf-result err';
      resultEl.textContent = '✗ Network error: ' + e.message;
    }
    if (form) form.querySelectorAll('input,select,textarea,button').forEach(el => el.disabled = false);
  }
}

// ── Skills System ─────────────────────────────────────────────
// Populated on load from /api/skills (reads Project-Iceberg/Skills/ on disk).
// Each entry: { id, name, slug, desc, tags:[], cmd }
let SKILLS_CATALOG = [];

async function loadSkills() {
  try {
    const r = await fetch('/api/skills');
    if (!r.ok) throw new Error(r.status);
    const data = await r.json();
    SKILLS_CATALOG = (data.skills || []).map(s => ({
      ...s,
      // Auto-generate a /command from the slug, removing hyphens
      cmd: '/' + s.slug.replace(/-/g, ''),
    }));
    // Refresh the panel if it's already visible
    const pane = document.getElementById('pane-skills');
    if (pane && !pane.classList.contains('hidden')) renderSkillsPanel('');
  } catch (e) {
    console.warn('[Skills] Failed to load from /api/skills:', e);
    const el = document.getElementById('sk-list');
    if (el) el.innerHTML = '<div style="font-size:11px;color:var(--red);padding:8px 4px">Could not load skills.</div>';
  }
}

// ── Install Skill modal ────────────────────────────────────────
function openInstallModal() {
  const modal = document.getElementById('install-skill-modal');
  const input = document.getElementById('install-skill-path');
  const err   = document.getElementById('install-skill-err');
  err.textContent  = '';
  input.value      = '';
  modal.style.display = 'flex';
  setTimeout(() => input.focus(), 60);
}

function closeInstallModal() {
  document.getElementById('install-skill-modal').style.display = 'none';
}

async function doInstallSkill() {
  const input = document.getElementById('install-skill-path');
  const err   = document.getElementById('install-skill-err');
  const btn   = document.getElementById('install-skill-btn');
  const path  = input.value.trim();
  if (!path) { err.textContent = 'Enter a path.'; return; }

  btn.textContent = 'installing…';
  btn.disabled    = true;
  err.textContent = '';

  try {
    const r    = await fetch('/api/skills/install', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ path }),
    });
    const data = await r.json();
    if (!r.ok || data.error) {
      err.textContent = data.error || 'Install failed.';
    } else {
      // Success — reload catalog and close
      await loadSkills();
      closeInstallModal();
    }
  } catch (e) {
    err.textContent = 'Network error: ' + e.message;
  } finally {
    btn.textContent = 'install';
    btn.disabled    = false;
  }
}

// Active skill state
const _activeSkills = new Set();
let _slashOpen = false;
let _slashIdx  = 0;
let _slashMatches = [];

// ── Tab switching ──────────────────────────────────────────────
let _skillsLoaded = false;
function switchTab(tab) {
  document.getElementById('tab-servers').classList.toggle('active', tab === 'servers');
  document.getElementById('tab-skills').classList.toggle('active', tab === 'skills');
  document.getElementById('pane-servers').classList.toggle('hidden', tab !== 'servers');
  document.getElementById('pane-skills').classList.toggle('hidden', tab !== 'skills');
  if (tab === 'skills') {
    if (!_skillsLoaded) {
      _skillsLoaded = true;
      loadSkills().then(() => renderSkillsPanel(''));
    } else {
      renderSkillsPanel('');
    }
  }
}

// ── Skills panel rendering ─────────────────────────────────────
function renderSkillsPanel(query) {
  const list   = document.getElementById('sk-list');
  const hdr    = document.getElementById('sk-active-hdr');
  const cnt    = document.getElementById('sk-active-count');
  const q      = (query || '').toLowerCase().trim();
  const skills = q
    ? SKILLS_CATALOG.filter(s =>
        s.name.toLowerCase().includes(q) ||
        s.desc.toLowerCase().includes(q) ||
        s.tags.some(t => t.toLowerCase().includes(q))
      )
    : SKILLS_CATALOG;

  const activeCount = _activeSkills.size;
  hdr.style.display = activeCount ? 'flex' : 'none';
  cnt.textContent   = activeCount + ' active';

  list.innerHTML = skills.map(s => {
    const isActive = _activeSkills.has(s.id);
    const tagHtml  = s.tags.map(t =>
      `<span class="slash-tag ${t}">${t}</span>`
    ).join('');
    return `<div class="sk-item${isActive ? ' active' : ''}" data-id="${s.id}">
      <div class="sk-info">
        <div class="sk-name">${s.name}</div>
        <div class="sk-desc">${s.desc}</div>
        <div style="margin-top:3px">${tagHtml}</div>
      </div>
      <button class="sk-add${isActive ? ' added' : ''}"
              onclick="toggleSkill('${s.id}')"
              title="${isActive ? 'Remove skill' : 'Add skill to task'}">
        ${isActive ? '✓' : '+'}
      </button>
    </div>`;
  }).join('');
}

function filterSkills(query) {
  renderSkillsPanel(query);
}

function toggleSkill(id) {
  if (_activeSkills.has(id)) {
    _activeSkills.delete(id);
  } else {
    _activeSkills.add(id);
  }
  // Re-render panel with current search query
  const q = document.getElementById('sk-search') ? document.getElementById('sk-search').value : '';
  renderSkillsPanel(q);
  renderSkillStrip();
}

function renderSkillStrip() {
  const strip = document.getElementById('sk-strip');
  const pills = document.getElementById('sk-strip-pills');
  if (!_activeSkills.size) {
    strip.style.display = 'none';
    return;
  }
  strip.style.display = 'flex';
  pills.innerHTML = [..._activeSkills].map(id => {
    const s = SKILLS_CATALOG.find(x => x.id === id);
    if (!s) return '';
    return `<span class="sk-pill">
      ${s.name}
      <button class="sk-pill-x" onclick="toggleSkill('${s.id}')" title="Remove">×</button>
    </span>`;
  }).join('');
}

// ── Slash popup ────────────────────────────────────────────────
function _buildSlashPopup() {
  const el = document.createElement('div');
  el.id        = 'slash-popup';
  el.className = 'slash-popup';
  el.style.display = 'none';
  el.innerHTML = `
    <div class="slash-hdr">
      <span class="slash-hdr-title">/ Skills</span>
      <span class="slash-hdr-hint">↑↓ navigate · Enter select · Esc close</span>
    </div>
    <div id="slash-list"></div>`;
  document.body.appendChild(el);
  return el;
}

function getSlashPopup() {
  return document.getElementById('slash-popup') || _buildSlashPopup();
}

function _positionSlashPopup() {
  const textarea = document.getElementById('cinput');
  const popup    = getSlashPopup();
  const rect     = textarea.getBoundingClientRect();
  popup.style.left   = rect.left + 'px';
  popup.style.width  = Math.min(rect.width, 380) + 'px';
  popup.style.bottom = (window.innerHeight - rect.top + 6) + 'px';
}

function showSlashPopup(query) {
  _slashOpen   = true;
  _slashIdx    = 0;
  _slashMatches = SKILLS_CATALOG.filter(s =>
    !query ||
    s.name.toLowerCase().includes(query) ||
    s.cmd.toLowerCase().includes(query) ||
    s.desc.toLowerCase().includes(query) ||
    s.tags.some(t => t.toLowerCase().includes(query))
  ).slice(0, 8);

  _positionSlashPopup();
  const popup = getSlashPopup();
  popup.style.display = 'block';
  renderSlashList(query);
}

function renderSlashList(query) {
  const list = document.getElementById('slash-list');
  if (!_slashMatches.length) {
    list.innerHTML = '<div style="padding:8px 12px;font-size:11px;color:var(--t3)">No matches</div>';
    return;
  }
  list.innerHTML = _slashMatches.map((s, i) => {
    const isActive = _activeSkills.has(s.id);
    const tagHtml  = s.tags.map(t =>
      `<span class="slash-tag ${t}${isActive ? ' ON' : ''}">${t}</span>`
    ).join('');
    // Highlight matched fragment in command
    const q   = (query || '').toLowerCase();
    const cmd = q && s.cmd.toLowerCase().includes(q)
      ? s.cmd.replace(new RegExp(`(${q})`, 'gi'), '<span class="hl">$1</span>')
      : s.cmd;
    return `<div class="slash-item${i === _slashIdx ? ' sel' : ''}"
                 onclick="selectSlashSkill(${i})"
                 onmouseover="_slashIdx=${i};renderSlashList('${(query||'').replace(/'/g,"\\'")}')">
      <div class="slash-cmd">${cmd}</div>
      <div class="slash-desc">${s.desc}</div>
      <div style="margin-top:2px">${tagHtml}</div>
    </div>`;
  }).join('');
}

function hideSlashPopup() {
  _slashOpen = false;
  const popup = document.getElementById('slash-popup');
  if (popup) popup.style.display = 'none';
}

function selectSlashSkill(idx) {
  const s = _slashMatches[idx];
  if (!s) return;
  // Toggle the skill on
  if (!_activeSkills.has(s.id)) {
    _activeSkills.add(s.id);
    renderSkillStrip();
    // If skills panel is open, refresh it
    const pane = document.getElementById('pane-skills');
    if (pane && !pane.classList.contains('hidden')) renderSkillsPanel('');
  }
  // Clear the /command fragment from textarea
  const ta  = document.getElementById('cinput');
  const val = ta.value;
  const slashPos = val.lastIndexOf('/');
  if (slashPos !== -1) ta.value = val.slice(0, slashPos);
  hideSlashPopup();
  ta.focus();
}

function navigateSlash(dir) {
  if (!_slashOpen || !_slashMatches.length) return;
  _slashIdx = (_slashIdx + dir + _slashMatches.length) % _slashMatches.length;
  // Recover current query from textarea
  const ta  = document.getElementById('cinput');
  const val = ta.value;
  const slashPos = val.lastIndexOf('/');
  const query = slashPos !== -1 ? val.slice(slashPos + 1).toLowerCase() : '';
  renderSlashList(query);
}

function handleInputChange(e) {
  const val = e.target.value;
  const slashPos = val.lastIndexOf('/');
  if (slashPos !== -1) {
    const query = val.slice(slashPos + 1).toLowerCase();
    showSlashPopup(query);
  } else {
    hideSlashPopup();
  }
}

// ── Chat ──────────────────────────────────────────────────────
function handleKey(e) {
  // Intercept slash popup navigation
  if (_slashOpen) {
    if (e.key === 'ArrowDown')  { e.preventDefault(); navigateSlash(1);  return; }
    if (e.key === 'ArrowUp')    { e.preventDefault(); navigateSlash(-1); return; }
    if (e.key === 'Enter')      { e.preventDefault(); selectSlashSkill(_slashIdx); return; }
    if (e.key === 'Escape')     { e.preventDefault(); hideSlashPopup(); return; }
  }
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMsg(); }
}

function appendMsg(role, html) {
  const m = document.getElementById('msgs');
  const d = document.createElement('div');
  d.className = 'msg ' + role;
  d.innerHTML = html;
  m.appendChild(d);
  m.scrollTop = m.scrollHeight;
  return d;
}

async function sendMsg() {
  const inp = document.getElementById('cinput');
  const txt = inp.value.trim();
  if (!txt || isSending) return;
  inp.value = '';
  isSending = true;
  setInputEnabled(false);

  appendMsg('u', '<div class="mmeta">You</div><div class="mbubble">' + esc(txt) + '</div>');

  // Reserve the assistant bubble early — we'll populate it token by token
  const bubble = appendMsg('a',
    '<div class="mmeta">Iceberg</div>' +
    '<div class="typing-wrap"><div class="tdot"></div><div class="tdot"></div><div class="tdot"></div></div>'
  );

  try {
    const res = await fetch('/api/chat/stream', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: txt }),
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);

    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let buf = '';          // partial SSE line buffer
    let msgDiv = null;     // the mbubble div we write tokens into
    let accumulated = '';  // full text built so far (for final formatting pass)

    while (true) {
      const { value, done } = await reader.read();
      if (done) break;

      buf += decoder.decode(value, { stream: true });

      // SSE frames are separated by double newlines; each frame is "data: {...}\n"
      const frames = buf.split('\n\n');
      buf = frames.pop(); // last entry may be incomplete — keep for next iteration

      for (const frame of frames) {
        const line = frame.trim();
        if (!line.startsWith('data: ')) continue;
        let event;
        try { event = JSON.parse(line.slice(6)); } catch { continue; }

        if (event.type === 'token' || event.type === 'result') {
          // First content: replace the typing indicator with a real bubble
          if (!msgDiv) {
            bubble.innerHTML =
              '<div class="mmeta">Iceberg</div><div class="mbubble"></div>';
            msgDiv = bubble.querySelector('.mbubble');
          }
          accumulated += event.text;
          // Render with newline → <br> conversion (no escaping needed for tokens
          // that come from the LLM — they're plain text, not HTML)
          msgDiv.innerHTML = esc(accumulated).replace(/\n/g, '<br>');
          // Keep the chat scrolled to the bottom as tokens arrive
          const msgs = document.getElementById('msgs');
          msgs.scrollTop = msgs.scrollHeight;
        }

        if (event.type === 'error') {
          bubble.innerHTML =
            '<div class="mmeta">Iceberg</div>' +
            '<div class="mbubble" style="color:var(--red)">' +
              'Error: ' + esc(event.text) +
            '</div>';
        }

        if (event.type === 'done') {
          // If nothing ever arrived (empty reply), show a placeholder
          if (!msgDiv) {
            bubble.innerHTML =
              '<div class="mmeta">Iceberg</div><div class="mbubble">…</div>';
          }
          break;
        }
      }
    }

    // Refresh status counters (memory count may have changed)
    loadStatus();
  } catch(e) {
    bubble.innerHTML =
      '<div class="mmeta">Iceberg</div>' +
      '<div class="mbubble" style="color:var(--red)">' +
        'Error: ' + esc(String(e)) + '<br>' +
        '<span style="color:var(--t3);font-size:11px">Is server.py still running?</span>' +
      '</div>';
  } finally {
    isSending = false;
    setInputEnabled(true);
    document.getElementById('cinput').focus();
  }
}

// ── Reset ─────────────────────────────────────────────────────
async function resetChat() {
  if (!confirm('Reset the conversation? This cannot be undone.')) return;
  try { await fetch('/api/reset', { method: 'POST' }); } catch(e) {}
  const m = document.getElementById('msgs');
  m.innerHTML =
    '<div class="msg a"><div class="mmeta">Iceberg</div>' +
    '<div class="mbubble">Conversation reset. Ready.</div></div>';
}

// ── Voice toggle ──────────────────────────────────────────────
function toggleVoice() {
  voiceOn = !voiceOn;
  const vb = document.getElementById('voice-btn');
  const ib = document.getElementById('vbtn');
  if (voiceOn) {
    vb.classList.add('active');
    ib.style.borderColor = 'var(--green)';
    ib.style.color = 'var(--green)';
  } else {
    vb.classList.remove('active');
    ib.style.borderColor = '';
    ib.style.color = '';
  }
}

// ── Add-server modal ──────────────────────────────────────────
let _pendingServer = null;

async function openModal() {
  // First, check if npx is installed
  try {
    const res = await fetch('/api/mcp/check-npx');
    const data = await res.json();
    
    if (!data.installed) {
      // Show npx missing modal instead
      showNpxMissingModal();
      return;
    }
    
    // npx is installed, proceed to catalog
    document.getElementById('modal').classList.add('open');
    await loadMCPCatalog();
  } catch(e) {
    console.error('Error checking npx:', e);
    // If check fails, still show catalog (fail open)
    document.getElementById('modal').classList.add('open');
    await loadMCPCatalog();
  }
}

function closeModal() {
  document.getElementById('modal').classList.remove('open');
}

document.getElementById('modal').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});

function showNpxMissingModal() {
  document.getElementById('npx-missing-modal').style.display = 'flex';
  setTimeout(() => document.getElementById('npx-missing-modal').classList.add('open'), 10);
}

function closeNpxMissingModal() {
  document.getElementById('npx-missing-modal').classList.remove('open');
  setTimeout(() => document.getElementById('npx-missing-modal').style.display = 'none', 300);
}

function openNodeJsDownload() {
  window.open('https://nodejs.org/en/download/', '_blank');
  closeNpxMissingModal();
}

async function loadMCPCatalog() {
  const listEl = document.getElementById('mcp-catalog-list');
  listEl.innerHTML = '<div style="font-size:11px;color:var(--t3);padding:8px 4px">Loading catalog…</div>';
  
  try {
    const res = await fetch('/api/mcp/catalog');
    if (!res.ok) throw new Error('Failed to load catalog');
    const data = await res.json();
    renderMCPCatalog(data.servers);
  } catch(e) {
    listEl.innerHTML = '<div style="font-size:11px;color:var(--red);padding:8px 4px">Failed to load catalog: ' + esc(String(e)) + '</div>';
  }
}

function renderMCPCatalog(servers) {
  const listEl = document.getElementById('mcp-catalog-list');
  
  if (!servers || servers.length === 0) {
    listEl.innerHTML = '<div style="font-size:11px;color:var(--t3);padding:8px 4px">No servers available.</div>';
    return;
  }
  
  listEl.innerHTML = servers.map(srv => `
    <div style="display:flex;align-items:center;gap:12px;padding:10px;border:1px solid var(--bdr);border-radius:6px;margin-bottom:8px;background:var(--card)">
      <div style="flex:1">
        <div style="font-size:13px;color:var(--t1);font-weight:500;margin-bottom:4px">${esc(srv.display_name)}</div>
        <div style="font-size:11px;color:var(--t2);line-height:1.5">${esc(srv.description)}</div>
      </div>
      <button onclick="addMCPServer('${esc(srv.name)}', ${srv.requires_api_key})" 
              style="padding:6px 14px;background:var(--accent);border:none;border-radius:4px;color:#fff;font-family:var(--fd);font-size:10px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;cursor:pointer;flex-shrink:0">
        + add
      </button>
    </div>
  `).join('');
}

function addMCPServer(serverName, requiresApiKey) {
  _pendingServer = serverName;
  
  if (requiresApiKey) {
    // Show API key input modal
    openApiKeyModal(serverName);
  } else {
    // Add directly without API key
    submitMCPServer(serverName, '');
  }
}

function openApiKeyModal(serverName) {
  // Find server in catalog to get label
  fetch('/api/mcp/catalog')
    .then(res => res.json())
    .then(data => {
      const srv = data.servers.find(s => s.name === serverName);
      if (srv) {
        document.getElementById('api-key-title').textContent = `Add ${srv.display_name}`;
        document.getElementById('api-key-label').textContent = srv.api_key_label || 'This server requires an API key.';
      }
    });
  
  document.getElementById('api-key-input').value = '';
  document.getElementById('api-key-modal').style.display = 'flex';
  setTimeout(() => document.getElementById('api-key-modal').classList.add('open'), 10);
}

function closeApiKeyModal() {
  document.getElementById('api-key-modal').classList.remove('open');
  setTimeout(() => document.getElementById('api-key-modal').style.display = 'none', 300);
  _pendingServer = null;
}

function submitApiKey() {
  const apiKey = document.getElementById('api-key-input').value.trim();
  if (!apiKey) {
    alert('Please enter an API key');
    return;
  }
  submitMCPServer(_pendingServer, apiKey);
}

async function submitMCPServer(serverName, apiKey) {
  closeApiKeyModal();
  closeModal();
  
  try {
    const res = await fetch('/api/mcp/add', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        server_name: serverName,
        api_key: apiKey
      })
    });
    
    const data = await res.json();
    
    if (!res.ok) {
      alert('Error adding server: ' + (data.error || 'Unknown error'));
      return;
    }
    
    // Show restart confirmation modal
    document.getElementById('restart-server-name').textContent = serverName;
    document.getElementById('restart-modal').style.display = 'flex';
    setTimeout(() => document.getElementById('restart-modal').classList.add('open'), 10);

  } catch(e) {
    alert('Error adding server: ' + String(e));
  }
}

// ── Restart modal ─────────────────────────────────────────────
function closeRestartModal() {
  document.getElementById('restart-modal').classList.remove('open');
  setTimeout(() => document.getElementById('restart-modal').style.display = 'none', 300);
}

async function restartNow() {
  closeRestartModal();
  // Show boot overlay while server restarts
  const overlay = document.getElementById('boot-overlay');
  document.getElementById('boot-status').textContent = 'Restarting…';
  overlay.style.display = 'flex';
  overlay.classList.remove('hidden');

  try {
    await fetch('/api/restart', { method: 'POST' });
  } catch(e) {
    // Expected — server going down
  }

  // Poll until server is back
  let attempts = 0;
  while (attempts < 60) {
    try {
      const res = await fetch('/api/ready');
      if (res.ok) {
        window.location.reload();
        return;
      }
    } catch(e) { /* not up yet */ }
    attempts++;
    await new Promise(r => setTimeout(r, 1000));
  }

  document.getElementById('boot-status').textContent = 'Restart timed out. Please refresh manually.';
  document.getElementById('boot-status').style.color = 'var(--red)';
}

// ── LLM picker ────────────────────────────────────────────────
let _allModels    = [];
let _currentModel = '';

async function openLLMPicker() {
  document.getElementById('llm-modal').classList.add('open');
  document.getElementById('llm-status-msg').textContent = '';
  document.getElementById('llm-status-msg').className = 'llm-status-msg';
  document.getElementById('llm-search').value = '';
  document.getElementById('model-list').innerHTML =
    '<div style="font-size:11px;color:var(--t3);padding:8px 4px">Loading…</div>';

  const [statusRes, modelsRes] = await Promise.allSettled([
    fetch('/api/status').then(r => r.json()),
    fetch('/api/llm/models').then(r => r.json()),
  ]);

  if (statusRes.status === 'fulfilled') {
    _currentModel = statusRes.value.llm || '';
  }

  if (modelsRes.status === 'fulfilled') {
    _allModels = modelsRes.value.models || [];
    const installedCount = _allModels.filter(m => m.pulled !== false).length;
    const catalogCount   = _allModels.filter(m => m.pulled === false).length;
    const sub = installedCount
      ? `${installedCount} installed · ${catalogCount} in catalog · active: ${_currentModel || 'none'}`
      : 'No Ollama models installed — pull one from the catalog below.';
    document.getElementById('llm-modal-sub').textContent = sub;
    renderModels(_allModels);
  } else {
    document.getElementById('llm-modal-sub').textContent = 'Could not reach Ollama.';
    document.getElementById('model-list').innerHTML =
      '<div style="font-size:11px;color:var(--t3);padding:8px 4px">Is Ollama running on localhost:11434?</div>';
  }
}

function closeLLMPicker() {
  document.getElementById('llm-modal').classList.remove('open');
}
document.getElementById('llm-modal').addEventListener('click', function(e) {
  if (e.target === this) closeLLMPicker();
});

function filterModels(q) {
  q = q.toLowerCase();
  const filtered = q
    ? _allModels.filter(m => m.name.toLowerCase().includes(q))
    : _allModels;
  renderModels(filtered);
}

function _isActiveModel(modelName) {
  // _currentModel is like "ollama (qwen2.5:14b)" — extract the part in parens
  const m = _currentModel.match(/\((.+)\)$/);
  const current = m ? m[1].trim() : _currentModel.trim();
  return current === modelName;
}

function renderModels(models) {
  const list = document.getElementById('model-list');
  if (!models.length) {
    list.innerHTML = '<div style="font-size:11px;color:var(--t3);padding:8px 4px">No models match.</div>';
    return;
  }

  // Group by: installed first, then uncensored, then popular
  const ORDER = ['installed', 'uncensored', 'popular'];
  const grouped = {};
  models.forEach(m => {
    const g = m.group || (m.pulled ? 'installed' : 'uncensored');
    if (!grouped[g]) grouped[g] = [];
    grouped[g].push(m);
  });

  const safeId = name => name.replace(/[^a-z0-9]/gi, '_');
  const GROUP_LABELS = { installed: 'Installed', uncensored: 'Uncensored', popular: 'Popular' };

  let html = '';
  ORDER.forEach(g => {
    if (!grouped[g] || !grouped[g].length) return;
    html += `<div class="model-group-label">${GROUP_LABELS[g] || g}</div>`;
    grouped[g].forEach(m => {
      const isActive = _isActiveModel(m.name);
      const isPulled = m.pulled !== false;
      const sid = safeId(m.name);

      const checkIcon = isActive
        ? `<svg class="mi-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2.5,8 6,11.5 13.5,4.5"/></svg>`
        : isPulled
          ? `<svg class="mi-check" viewBox="0 0 16 16" style="opacity:0.18"><circle cx="8" cy="8" r="3" fill="currentColor"/></svg>`
          : `<svg class="mi-dl" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="2" x2="8" y2="11"/><polyline points="5,8.5 8,11.5 11,8.5"/><line x1="2" y1="14" x2="14" y2="14"/></svg>`;

      const badge = (m.group === 'uncensored')
        ? `<span class="mi-badge">uncensored</span>` : '';

      const clickFn = isPulled
        ? `selectModel('ollama','${m.name}')`
        : `pullModel('${m.name}','${sid}')`;

      html += `<div class="model-item${isActive ? ' active' : ''}${!isPulled ? ' not-pulled' : ''}"
               id="mi-${sid}" onclick="${clickFn}">
          ${checkIcon}
          <div style="flex:1;min-width:0">
            <div class="mi-name">${esc(m.name)}</div>
            ${m.desc ? `<div class="mi-desc">${esc(m.desc)}</div>` : ''}
          </div>
          ${badge}
          <span class="mi-size">${m.size || ''}</span>
          <span class="mi-prov">ollama</span>
        </div>`;
    });
  });
  list.innerHTML = html;
}

async function selectModel(provider, model) {
  const statusEl = document.getElementById('llm-status-msg');
  statusEl.textContent = 'Switching…';
  statusEl.className = 'llm-status-msg';
  try {
    const res = await fetch('/api/llm/set', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ provider, model }),
    });
    const data = await res.json();
    if (data.error) throw new Error(data.error);
    _currentModel = `${provider} (${model})`;
    statusEl.textContent = `✓ Active: ${model}`;
    statusEl.className = 'llm-status-msg ok';
    renderModels(_allModels);
    loadStatus();
  } catch(e) {
    statusEl.textContent = 'Error: ' + e.message;
    statusEl.className = 'llm-status-msg err';
  }
}

async function pullModel(modelName, sid) {
  const statusEl = document.getElementById('llm-status-msg');
  const cardEl   = document.getElementById('mi-' + sid);
  if (cardEl) cardEl.classList.add('loading');
  statusEl.innerHTML = `Pulling ${esc(modelName)}…` +
    `<div class="pull-bar-wrap"><div class="pull-bar" id="pull-bar"></div></div>`;
  statusEl.className = 'llm-status-msg';

  try {
    const res = await fetch('/api/ollama/pull', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: modelName }),
    });
    const reader  = res.body.getReader();
    const decoder = new TextDecoder();
    let buf = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buf += decoder.decode(value, { stream: true });
      const lines = buf.split('\n');
      buf = lines.pop();
      for (const line of lines) {
        if (!line.startsWith('data: ')) continue;
        let event;
        try { event = JSON.parse(line.slice(6)); } catch { continue; }
        const bar = document.getElementById('pull-bar');
        if (event.type === 'progress') {
          if (bar) bar.style.width = (event.pct || 0) + '%';
          if (statusEl.firstChild)
            statusEl.firstChild.textContent = `Pulling ${modelName}: ${event.text}`;
        } else if (event.type === 'status') {
          if (statusEl.firstChild)
            statusEl.firstChild.textContent = `Pulling ${modelName}: ${event.text}`;
        } else if (event.type === 'done') {
          statusEl.textContent = `✓ Pulled ${modelName}`;
          statusEl.className = 'llm-status-msg ok';
          openLLMPicker(); // refresh — newly pulled model is now installed
          return;
        } else if (event.type === 'error') {
          throw new Error(event.text);
        }
      }
    }
  } catch(e) {
    statusEl.textContent = 'Pull failed: ' + e.message;
    statusEl.className = 'llm-status-msg err';
    if (cardEl) cardEl.classList.remove('loading');
  }
}

// ── File Viewer ────────────────────────────────────────────────
let _fvCurrentPath  = '';
let _fvSheets       = [];
let _fvActiveSheet  = '';
let _fvMaxRows      = 200;

function openFileViewer() {
  document.getElementById('fv-modal').classList.add('open');
  document.getElementById('fv-content').innerHTML = '';
  document.getElementById('fv-sheet-tabs').innerHTML = '';
  document.getElementById('fv-path').value = '';
  document.getElementById('fv-status').textContent = 'Drop a file or paste a path to begin.';
  _fvCurrentPath = '';
  _fvSheets      = [];
  _fvActiveSheet = '';
}

function closeFileViewer() {
  document.getElementById('fv-modal').classList.remove('open');
}
document.addEventListener('DOMContentLoaded', () => {
  const fvm = document.getElementById('fv-modal');
  if (fvm) fvm.addEventListener('click', e => { if (e.target === fvm) closeFileViewer(); });
});

function fvHandleDrop(e) {
  e.preventDefault();
  e.currentTarget.classList.remove('drag-over');
  const file = e.dataTransfer.files[0];
  if (file) fvUploadAndView(file);
}
function fvHandleDragOver(e)  { e.preventDefault(); e.currentTarget.classList.add('drag-over'); }
function fvHandleDragLeave(e) { e.currentTarget.classList.remove('drag-over'); }
function fvHandleFileInput(e) { const f = e.target.files[0]; if (f) fvUploadAndView(f); }

async function fvUploadAndView(file) {
  fvSetLoading(`Uploading ${file.name}…`);
  try {
    const fd = new FormData();
    fd.append('file', file);
    const res  = await fetch('/api/file/upload', { method: 'POST', body: fd });
    const data = await res.json();
    if (data.message && data.type === 'error') throw new Error(data.message);
    _fvCurrentPath = data.upload_path;
    document.getElementById('fv-path').value = data.upload_path;
    _fvRender(data);
  } catch(e) {
    fvSetError(e.message);
  }
}

async function fvLoadPath() {
  const path = document.getElementById('fv-path').value.trim();
  if (!path) return;
  _fvCurrentPath = path;
  fvSetLoading('Loading…');
  try {
    const res  = await fetch('/api/file/view', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path, sheet: _fvActiveSheet, max_rows: _fvMaxRows }),
    });
    const data = await res.json();
    if (data.error) throw new Error(data.error);
    _fvRender(data);
  } catch(e) {
    fvSetError(e.message);
  }
}

async function fvSwitchSheet(sheet) {
  _fvActiveSheet = sheet;
  document.querySelectorAll('.fv-sheet-tab').forEach(t =>
    t.classList.toggle('active', t.dataset.sheet === sheet)
  );
  fvSetLoading(`Loading sheet "${sheet}"…`);
  try {
    const res  = await fetch('/api/file/view', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path: _fvCurrentPath, sheet, max_rows: _fvMaxRows }),
    });
    const data = await res.json();
    if (data.error) throw new Error(data.error);
    _fvRender(data);
  } catch(e) {
    fvSetError(e.message);
  }
}

function fvApplyMaxRows() {
  const sel = document.getElementById('fv-maxrows');
  _fvMaxRows = parseInt(sel.value, 10) || 200;
  if (_fvCurrentPath) fvLoadPath();
}

function _fvEsc(s) {
  return String(s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function _fvRender(data) {
  const contentEl = document.getElementById('fv-content');
  const statusEl  = document.getElementById('fv-status');
  const tabsEl    = document.getElementById('fv-sheet-tabs');
  const dropEl    = document.getElementById('fv-drop-zone');

  // Hide drop zone once content is loaded
  if (dropEl) dropEl.style.display = 'none';

  // Sheet tabs — show only when more than one sheet
  if (data.sheets && data.sheets.length > 1) {
    _fvSheets      = data.sheets;
    _fvActiveSheet = data.sheet || data.sheets[0];
    tabsEl.innerHTML = data.sheets.map(s =>
      `<button class="fv-sheet-tab${s === _fvActiveSheet ? ' active' : ''}"
               data-sheet="${_fvEsc(s)}"
               onclick="fvSwitchSheet('${_fvEsc(s)}')">${_fvEsc(s)}</button>`
    ).join('');
  } else {
    tabsEl.innerHTML = '';
  }

  if (data.type === 'error') { fvSetError(data.message || data.content || 'Unknown error'); return; }

  if (data.type === 'table') {
    const headers = data.headers || [];
    const rows    = data.rows    || [];

    let tbl = '<table class="fv-table"><thead><tr><th class="fv-row-num">#</th>';
    headers.forEach(h => { tbl += `<th>${_fvEsc(String(h))}</th>`; });
    tbl += '</tr></thead><tbody>';
    rows.forEach((row, i) => {
      tbl += `<tr><td class="fv-row-num">${i + 1}</td>`;
      headers.forEach((_, ci) => {
        const cell = (row[ci] !== undefined && row[ci] !== null) ? String(row[ci]) : '';
        tbl += `<td title="${_fvEsc(cell)}">${_fvEsc(cell)}</td>`;
      });
      tbl += '</tr>';
    });
    tbl += '</tbody></table>';
    contentEl.innerHTML = tbl;

    const total = data.total_rows || rows.length;
    let st = `${rows.length.toLocaleString()} of ${total.toLocaleString()} rows · ${headers.length} columns`;
    if (data.truncated) st += ' · ⚠ truncated — increase max rows to see more';
    statusEl.textContent = st;

  } else {
    // text / code view
    contentEl.innerHTML =
      `<pre class="fv-code"><code>${_fvEsc(data.content || '')}</code></pre>`;
    const chars = (data.content || '').length;
    let st = `${chars.toLocaleString()} chars`;
    if (data.language) st += ` · ${data.language}`;
    if (data.truncated) st += ' · ⚠ truncated';
    statusEl.textContent = st;
  }
}

function fvSetLoading(msg) {
  document.getElementById('fv-status').textContent = msg || 'Loading…';
  document.getElementById('fv-content').innerHTML =
    '<div class="fv-spinner">⟳</div>';
  const dropEl = document.getElementById('fv-drop-zone');
  if (dropEl) dropEl.style.display = 'none';
}

function fvSetError(msg) {
  document.getElementById('fv-status').textContent = 'Error';
  document.getElementById('fv-content').innerHTML =
    `<div style="color:var(--red);padding:28px 24px;font-size:12px;line-height:1.6">⚠ ${_fvEsc(msg)}</div>`;
  const dropEl = document.getElementById('fv-drop-zone');
  if (dropEl) dropEl.style.display = 'none';
}

boot();

</script>

<!-- ── FILE VIEWER MODAL ──────────────────────────────────────────── -->
<div class="modal-bg fv-modal-bg" id="fv-modal">
  <div class="fv-panel">

    <!-- Header -->
    <div class="fv-header">
      <span class="fv-title">◫ File Viewer</span>

      <div class="fv-path-row">
        <input class="fv-path-input" id="fv-path" type="text"
               placeholder="Paste an absolute file path and press Enter…"
               onkeydown="if(event.key==='Enter')fvLoadPath()">
        <button class="fv-btn" onclick="fvLoadPath()">Open</button>
      </div>

      <div class="fv-controls-row">
        <label class="fv-label">Max rows
          <select class="fv-select" id="fv-maxrows" onchange="fvApplyMaxRows()">
            <option value="100">100</option>
            <option value="200" selected>200</option>
            <option value="500">500</option>
            <option value="1000">1 000</option>
            <option value="5000">5 000</option>
          </select>
        </label>
        <label class="fv-label" style="margin-left:8px;cursor:pointer">
          <input type="file" id="fv-file-input" style="display:none"
                 onchange="fvHandleFileInput(event)">
          <button class="fv-btn" onclick="document.getElementById('fv-file-input').click()">Browse…</button>
        </label>
        <button class="fv-btn fv-close" onclick="closeFileViewer()" style="margin-left:auto">✕ close</button>
      </div>
    </div>

    <!-- Drag-drop zone (visible when no file loaded) -->
    <div class="fv-drop-zone" id="fv-drop-zone"
         ondrop="fvHandleDrop(event)"
         ondragover="fvHandleDragOver(event)"
         ondragleave="fvHandleDragLeave(event)"
         onclick="document.getElementById('fv-file-input').click()">
      <div class="fv-drop-icon">◫</div>
      <div class="fv-drop-hint">Drop a file here, or click to browse</div>
      <div class="fv-drop-types">Excel · CSV · PDF · Word · JSON · TXT · Python · and more</div>
    </div>

    <!-- Sheet tabs (hidden until multi-sheet file) -->
    <div class="fv-sheet-tabs" id="fv-sheet-tabs"></div>

    <!-- Scrollable content area -->
    <div class="fv-content-wrap">
      <div class="fv-content" id="fv-content"></div>
    </div>

    <!-- Status bar -->
    <div class="fv-statusbar">
      <span id="fv-status">Drop a file or paste a path to 