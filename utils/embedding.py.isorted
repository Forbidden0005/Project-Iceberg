"""
Embedding utilities for Project Iceberg memory system.

Two strategies, used in priority order:

  1. OllamaEmbedder  -- calls nomic-embed-text via Ollama for true semantic
     similarity. Requires Ollama running at localhost:11434 with the model
     pulled (ollama pull nomic-embed-text). Returns float-list vectors.

  2. Bag-of-words fallback -- the original L1-normalised term-frequency
     approach. No external deps. Adequate for small stores; degrades
     gracefully when Ollama is not reachable or returns an error.

External callers should use:
  get_embedder()      -> the best available Embedder instance
  text_to_vector()    -> bag-of-words dict (legacy, still used by dedup path)
  cosine_similarity() -> works on both dict and list vectors
"""

from __future__ import annotations

import math
import re
from collections import Counter
from typing import Union

import requests

# ---------------------------------------------------------------------------
# Bag-of-words (legacy / fallback)
# ---------------------------------------------------------------------------

_TOKEN_RE = re.compile(r"[a-z0-9]+")

_STOPWORDS = {
    "the",
    "a",
    "an",
    "and",
    "or",
    "but",
    "is",
    "are",
    "was",
    "were",
    "be",
    "been",
    "being",
    "to",
    "of",
    "in",
    "on",
    "at",
    "for",
    "with",
    "this",
    "that",
    "these",
    "those",
    "it",
    "its",
    "as",
    "by",
    "from",
    "i",
    "you",
    "he",
    "she",
    "we",
    "they",
    "me",
    "my",
    "your",
}

# Type alias: a vector is either a term-freq dict or a float list
Vector = Union[dict, list]


def text_to_vector(text: str) -> dict:
    """L1-normalised bag-of-words term frequency vector (no deps)."""
    if not text:
        return {}
    tokens = [t for t in _TOKEN_RE.findall(text.lower()) if t not in _STOPWORDS]
    if not tokens:
        return {}
    counts = Counter(tokens)
    total = sum(counts.values())
    return {word: count / total for word, count in counts.items()}


def cosine_similarity(a: Vector, b: Vector) -> float:
    """Cosine similarity that works on both dict-based and list-based vectors."""
    if not a or not b:
        return 0.0

    # Both are lists (Ollama embeddings)
    if isinstance(a, list) and isinstance(b, list):
        if len(a) != len(b):
            return 0.0
        dot = sum(x * y for x, y in zip(a, b))
        norm_a = math.sqrt(sum(x * x for x in a))
        norm_b = math.sqrt(sum(x * x for x in b))
        if norm_a == 0 or norm_b == 0:
            return 0.0
        return dot / (norm_a * norm_b)

    # Both are dicts (bag-of-words)
    if isinstance(a, dict) and isinstance(b, dict):
        shared = set(a) & set(b)
        if not shared:
            return 0.0
        dot = sum(a[k] * b[k] for k in shared)
        norm_a = math.sqrt(sum(v * v for v in a.values()))
        norm_b = math.sqrt(sum(v * v for v in b.values()))
        if norm_a == 0 or norm_b == 0:
            return 0.0
        return dot / (norm_a * norm_b)

    # Mixed types -- incomparable
    return 0.0


# ---------------------------------------------------------------------------
# Ollama semantic embedder
# ---------------------------------------------------------------------------

_OLLAMA_EMBED_URL = "http://localhost:11434/api/embeddings"
_EMBED_MODEL = "nomic-embed-text"
_EMBED_TIMEOUT = 10


class OllamaEmbedder:
    """Semantic embedder backed by Ollama's nomic-embed-text model."""

    def __init__(
        self,
        url: str = _OLLAMA_EMBED_URL,
        model: str = _EMBED_MODEL,
        timeout: int = _EMBED_TIMEOUT,
    ) -> None:
        self._url = url
        self._model = model
        self._timeout = timeout
        self._reachable = None  # cached after first probe

    def available(self) -> bool:
        """Probe Ollama once and cache the result for the process lifetime."""
        if self._reachable is None:
            self._reachable = self._probe()
        return self._reachable

    def _probe(self) -> bool:
        try:
            resp = requests.post(
                self._url,
                json={"model": self._model, "prompt": "ping"},
                timeout=self._timeout,
            )
            return resp.status_code == 200 and "embedding" in resp.json()
        except Exception:
            return False

    def embed(self, text: str):
        """Return a float embedding vector, or None on failure."""
        if not text:
            return None
        try:
            resp = requests.post(
                self._url,
                json={"model": self._model, "prompt": text},
                timeout=self._timeout,
            )
            if resp.status_code == 200:
                data = resp.json()
                vec = data.get("embedding")
                if isinstance(vec, list) and vec:
                    return vec
        except Exception:
            pass
        return None


# ---------------------------------------------------------------------------
# Unified embedder facade
# ---------------------------------------------------------------------------


class BagOfWordsEmbedder:
    """Wraps bag-of-words behind the same interface as OllamaEmbedder."""

    def available(self) -> bool:
        return True

    def embed(self, text: str) -> dict:
        return text_to_vector(text)


class SmartEmbedder:
    """Tries Ollama first; falls back to bag-of-words if unavailable.

    Keeps a single strategy for the process lifetime to avoid per-call
    latency from re-probing Ollama on every embed call.
    """

    def __init__(self) -> None:
        self._ollama = OllamaEmbedder()
        self._bow = BagOfWordsEmbedder()
        self._using_ollama = None

    @property
    def mode(self) -> str:
        """'ollama' or 'bag-of-words' -- whichever is active."""
        if self._using_ollama is None:
            self._using_ollama = self._ollama.available()
        return "ollama" if self._using_ollama else "bag-of-words"

    def embed(self, text: str):
        """Embed text using the best available strategy."""
        if self.mode == "ollama":
            vec = self._ollama.embed(text)
            if vec is not None:
                return vec
        return self._bow.embed(text)


# Module-level singleton so the Ollama probe only runs once per process
_smart_embedder = None


def get_embedder() -> SmartEmbedder:
    """Return the module-level SmartEmbedder (created lazily)."""
    global _smart_embedder
    if _smart_embedder is None:
        _smart_embedder = SmartEmbedder()
    return _smart_embedder
